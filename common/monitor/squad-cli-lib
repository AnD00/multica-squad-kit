# JSON の応答を検証・整形する。第 2 引数は、テストなどで固定する CLI のバージョン。
# 入力の検証がすべて済むまで標準出力には何も返さない。
squad_cli_normalize() {
	local name=$1 entry
	entry=$(squad_cli_contracts | jq -ce --arg name "$name" '.entries[$name] | select(. != null)') || {
		echo "CLI の読み取りが約束にありません: $name" >&2
		return 1
	}
	if [[ $# == 1 ]]; then
		squad_cli_check_entry "$name" "$entry"
	else
		squad_cli_check_entry "$name" "$entry" "$2"
	fi
}

# 取り出した約束の項目で、標準入力の JSON を検証・整形する。
# 第 3 引数のバージョンを省くと、欄が欠けて失敗するメッセージを作るときだけ、実物の CLI から読む。
squad_cli_check_entry() {
	local name=$1 entry=$2 version=${3-} mode=fixed program
	(($# >= 3)) || mode=read
	program=$(cat <<'PY'
import copy
import json
import os
import subprocess
import sys

name, entry, version, mode = sys.argv[1], json.loads(sys.argv[2]), sys.argv[3], sys.argv[4]
errors = []
missing = object()

def cli_version():
    global version, mode
    if mode == "read":
        mode = "fixed"
        command = {"gh": ["gh", "--version"], "codex": ["codex", "--version"]}.get(
            (entry.get("command") or [None])[0], ["multica", "version"])
        try:
            result = subprocess.run(command, stdin=subprocess.DEVNULL, capture_output=True,
                                    text=True, errors="replace")
            version = result.stdout.split("\n")[0] if result.returncode == 0 else ""
        except OSError:
            version = ""
    return version

def get(value, path):
    for key in path:
        if not isinstance(value, dict) or key not in value:
            return missing
        value = value[key]
    return value

def matches(value, expression):
    result = subprocess.run(["jq", "-e", expression], input=json.dumps(value),
                            capture_output=True, text=True)
    if result.returncode not in (0, 1, 4):
        raise ValueError("約束の条件が不正です")
    return result.returncode == 0

def report(reason, field, value, index, when=None):
    identity = value.get("id", index) if isinstance(value, dict) else index
    context = (when + " のとき、" if when else "") + "要素 " + str(identity)
    suffix = "（" + cli_version() + "）" if cli_version() else ""
    errors.append(f"CLI の出力{reason}: {name} の {field}（{context}）{suffix}")

def project(value, tree):
    if not tree or not isinstance(value, dict):
        return copy.deepcopy(value)
    return {key: project(value[key], children) for key, children in tree.items() if key in value}

def normalize(value, schema, index, prefix=""):
    fields = schema.get("fields", [])
    if not isinstance(value, dict):
        report("の形が不正です", "object", value, index)
        return value
    tree = {}
    for field in fields:
        path = field["path"].split(".")
        node = tree
        for key in path:
            node = node.setdefault(key, {})
        when = field.get("when")
        required = field["class"] == "required" or (when is not None and matches(value, when))
        actual = get(value, path)
        if required and actual is missing:
            report("に欄がありません", prefix + field["path"], value, index, when)
        elif required and actual is None and not field["nullable"]:
            report("の欄が null です", prefix + field["path"], value, index, when)
    result = project(value, tree)
    mapping = schema.get("values")
    if mapping:
        path = mapping["path"]
        values = get(value, path)
        if values is not missing:
            if not isinstance(values, dict):
                report("の形が不正です", prefix + ".".join(path), value, index)
            else:
                parent = get(result, path[:-1])
                if isinstance(parent, dict):
                    parent[path[-1]] = {key: normalize(item, mapping, key, prefix + ".".join(path) + "." + key + ".")
                                          for key, item in values.items()}
    child = schema.get("items")
    if child and (not child.get("when") or matches(value, child["when"])):
        path = child["path"]
        items = get(value, path)
        if items is not missing:
            if not isinstance(items, list):
                report("の形が不正です", prefix + ".".join(path), value, index)
            else:
                parent = get(result, path[:-1])
                if isinstance(parent, dict):
                    parent[path[-1]] = [normalize(item, child, position, prefix + ".".join(path) + "[].")
                                           for position, item in enumerate(items)]
    return result

try:
    decoder = json.JSONDecoder()
    text = sys.stdin.read().strip()
    pages = []
    while text:
        page, end = decoder.raw_decode(text)
        pages.append(page)
        text = text[end:].lstrip()
    if not pages or len(pages) > 1 and "pagination" not in entry:
        raise ValueError("応答の個数が不正です")
    normalized = []
    for page in pages:
        if entry["shape"] == "array":
            if not isinstance(page, list):
                raise ValueError("配列ではありません")
            normalized.append([normalize(item, entry["items"], index) for index, item in enumerate(page)])
        else:
            normalized.append(normalize(page, entry, 0))
    if entry.get("pagination", {}).get("kind") == "array":
        result = [item for page in normalized for item in page]
        value = [item for page in pages for item in page]
    else:
        result, value = normalized[0], copy.deepcopy(pages[0])
        path = entry.get("pagination", {}).get("path")
        if path and not errors:
            for target, source in [(result, normalized), (value, pages)]:
                get(target, path[:-1])[path[-1]] = [item for page in source for item in get(page, path)]
    if errors:
        print("\n".join(errors), file=sys.stderr)
        sys.exit(1)
    # テストだけで使う。検証は省かず、射影の前後で呼び出し元の動作を比べる。
    if os.environ.get("SQUAD_CLI_TEST_KEEP_FIELDS") == "1":
        result = value
    print(json.dumps(result, ensure_ascii=False))
except (ValueError, TypeError, KeyError) as error:
    print(f"CLI の出力を確認できません: {name}（{error}）", file=sys.stderr)
    sys.exit(1)
PY
	) || return 1
	python3 -c "$program" "$name" "$entry" "$version" "$mode"
}

# Codex: app-server の account/rateLimits/read を呼び、応答の .result を 1 行の JSON で出す。
# モデルを呼ばないので、使用量を消費しない。
# app-server は stdin が閉じると終わるので、応答が来るか 30 秒たつまで、stdin を開けたまま待つ。
squad_cli_codex_usage() {
	local out_file
	mkdir -p "$PWD/tmp" || return 1
	out_file=$(mktemp "$PWD/tmp/squad-codex.XXXXXX") || return 1
	{
		printf '%s\n' \
			'{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"clientInfo":{"name":"squad-usage-check","version":"1.0.0"}}}' \
			'{"jsonrpc":"2.0","method":"initialized"}' \
			'{"jsonrpc":"2.0","id":2,"method":"account/rateLimits/read"}'
		for _ in $(seq 30); do
			grep -q '"id":2' "$out_file" && break
			sleep 1
		done
	} | codex app-server >"$out_file" 2>/dev/null || true

	local res
	res=$(jq -c 'select(.id == 2)' "$out_file" 2>/dev/null || true)
	rm -f "$out_file"
	if [[ -z "$res" ]]; then
		echo "codex app-server から使用量の応答がなかった" >&2
		return 1
	fi
	if ! jq -e '.result' <<<"$res" >/dev/null; then
		echo "codex app-server がエラーを返した: $(jq -r '.error.message // .' <<<"$res")" >&2
		return 1
	fi
	jq -c '.result' <<<"$res"
}

# 約束のコマンドの {引数} を、記載順の位置引数で埋める。
# その後の引数は --limit などの追加オプション。JSON の出力指定は変更させない。
# 書き込みもここを通せるが、失敗した応答の検証を理由に投稿し直してはいけない。
squad_cli_read() {
	local name=$1 entry token raw status
	local -a command=()
	shift
	# 約束の項目（1 行目）と、そのコマンド（2 行目以降）を、1 回の jq でまとめて取り出す。
	{
		IFS= read -r entry
		if [[ -z $entry ]]; then
			echo "CLI の読み取りが約束にありません: $name" >&2
			return 1
		fi
		# app-server は CLI の位置引数でなく、初期化後の JSON-RPC で問い合わせる。
		if [[ $name == codex-rate-limits ]]; then
			(($# == 0)) || { echo 'Codex の使用量の読み取りに追加の引数は渡せません' >&2; return 1; }
			command=(squad_cli_codex_usage)
		else
		while IFS= read -r token; do
			if [[ $token == \{*\} ]]; then
				(($# > 0)) || { echo "CLI の読み取りの引数が足りません: $name の $token" >&2; return 1; }
				command+=("$1")
				shift
			else
				command+=("$token")
			fi
		done
		fi
	} < <(squad_cli_contracts | jq -rc --arg name "$name" '.entries[$name] | select(. != null) | ., .command[]')
	for token in "$@"; do
		case $token in
		--compact|--compact=*|--output|--output=*|--json|--json=*)
			echo "CLI の JSON の出力指定は変更できません: $name の $token" >&2
			return 1 ;;
		esac
	done
	if raw=$("${command[@]}" "$@"); then
		printf '%s\n' "$raw" | squad_cli_check_entry "$name" "$entry"
	else
		status=$?
		return "$status"
	fi
}

# 回を書いた役をリーダーとする、有効なスクワッドを 1 つだけ返す。
# review-wait と PR の見張りで、同じ選び方を使う。
# 候補が 0 件・複数なら 2、CLI・欄の検証の失敗なら 1 を返す。
squad_cli_squad_for_leader() {
	local leader=$1 squads matches count
	squads=$(squad_cli_read squad-list) || return 1
	matches=$(jq --arg leader "$leader" '[.[] | select(.leader_id == $leader and .archived_at == null)]' <<<"$squads") || return 1
	count=$(jq length <<<"$matches") || return 1
	if [[ $count != 1 ]]; then
		printf '知らせるスクワッドを決められません: %s 件（回を書いたエージェント %s）\n' "$count" "$leader" >&2
		return 2
	fi
	jq '.[0]' <<<"$matches"
}

# 回を書いたコメントから、知らせるスクワッドを JSON で出す。
# 回を書いたエージェントがリーダーのスクワッドがあれば、それを使う。なければ、次の依頼のように役が書いた回なので、
# `前の回:` をたどって（同じタスクのコメントだけ。10 回まで）、リーダーが書いた回のスクワッドを使う。
# 決められなければ 2、CLI・欄の検証の失敗なら 1 を返す。review-wait・次の依頼の決定・使用率の待ちが同じ決め方を使う。
squad_cli_squad_for_round() {
	local comments=$1 current=$2 squads hop comment author matches count mark='前の回:'
	squads=$(squad_cli_read squad-list) || return 1
	for ((hop = 0; hop <= 10; hop++)); do
		comment=$(jq -c --arg id "$current" '[.[] | select(.id == $id)] | first // {}' <<<"$comments") || return 1
		author=$(jq -r '.author_id // empty' <<<"$comment") || return 1
		[[ -n $author ]] || break
		matches=$(jq -c --arg leader "$author" '[.[] | select(.leader_id == $leader and .archived_at == null)]' <<<"$squads") || return 1
		count=$(jq length <<<"$matches") || return 1
		if ((count == 1)); then
			jq '.[0]' <<<"$matches"
			return 0
		fi
		if ((count > 1)); then
			printf '知らせるスクワッドを決められません: %s 件（回を書いたエージェント %s）\n' "$count" "$author" >&2
			return 2
		fi
		current=$(jq -r --arg mark "$mark" '(.content // "") | split("\n") | map(select(startswith($mark))) | first // "" | ltrimstr($mark) | gsub("^\\s+|\\s+$"; "")' <<<"$comment") || return 1
		[[ -n $current ]] || break
	done
	printf '知らせるスクワッドを決められません: 回を書いたエージェント %s はどのスクワッドのリーダーでもなく、`前の回:` をたどってもリーダーの回に着きません\n' "${author:-不明}" >&2
	return 2
}

# エージェントの名前（<プロジェクトのキー>-<役>-<メンバーのキー>）から、このスクワッドの役を読む。
# キーに - は入らないので、スクワッドの名前（キーとメンバーのキーを - でつなぎ大文字にしたもの）と
# 先頭・末尾が合う名前の、間を役とする。アーカイブ済みのエージェントとキーが合わないものは入れない。
# {leader, roles: {<役>: {id, model, name}}} を出す。見張りと次の依頼の決定が同じ名簿を使う。
# 2 つ目の引数にスクワッドの ID があれば、そのスクワッドの名簿を読む（回から決めたスクワッド）。
# なければ、タスクの担当のスクワッドを使う。
squad_cli_read_roster() {
	local issue=$1 squad_id=${2-} task squads squad key member members ids id agent roles='{}' name role
	if [[ -z $squad_id ]]; then
		task=$(squad_cli_read issue-get "$issue") || return 1
		squad_id=$(jq -r 'if .assignee_type == "squad" then .assignee_id else "" end' <<<"$task")
		if [[ -z $squad_id ]]; then
			echo "タスクの担当がスクワッドではないため、名簿を読めない: $issue" >&2
			return 1
		fi
	fi
	squads=$(squad_cli_read squad-list) || return 1
	squad=$(jq -c --arg id "$squad_id" '[.[] | select(.id == $id and .archived_at == null)] | first // empty' <<<"$squads") || return 1
	if [[ -z $squad ]]; then
		echo "タスクの担当のスクワッドが一覧にない、またはアーカイブ済み: $squad_id" >&2
		return 1
	fi
	if ! jq -e '.name | ascii_downcase | split("-") | length == 2' <<<"$squad" >/dev/null; then
		echo 'スクワッドの名前から、キーとメンバーのキーを読めない' >&2
		return 1
	fi
	key=$(jq -r '.name | ascii_downcase | split("-")[0]' <<<"$squad")
	member=$(jq -r '.name | ascii_downcase | split("-")[1]' <<<"$squad")
	members=$(squad_cli_read squad-member-list "$squad_id") || return 1
	ids=$(jq -r '.[] | select(.member_type == "agent") | .member_id' <<<"$members")
	while IFS= read -r id; do
		[[ -n $id ]] || continue
		agent=$(squad_cli_read agent-get "$id") || return 1
		role=$(jq -r --arg key "$key" --arg member "$member" '
			select(.archived_at == null)
			| (.name | ascii_downcase) as $name
			| if ($name | startswith($key + "-")) and ($name | endswith("-" + $member))
				and ($name | length) > ($key | length) + ($member | length) + 2
			then $name[($key | length) + 1:-(($member | length) + 1)] else empty end' <<<"$agent") || return 1
		[[ -n $role ]] || continue
		roles=$(jq -c --arg role "$role" --argjson agent "$agent" \
			'if has($role) then . else .[$role] = {id: $agent.id, model: $agent.model, name: $agent.name} end' <<<"$roles")
	done <<<"$ids"
	jq -cn --argjson squad "$squad" --argjson roles "$roles" '{leader: $squad.leader_id, roles: $roles}'
}
