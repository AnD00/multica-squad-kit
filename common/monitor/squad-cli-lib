# JSON の応答を検証・整形する。第 2 引数は、テストなどで固定する CLI の版。
# 入力の検証がすべて済むまで標準出力には何も返さない。
squad_cli_normalize() {
	local name=$1 entry version=${2-} program
	entry=$(squad_cli_contracts | jq -ce --arg name "$name" '.entries[$name] | select(. != null)') || {
		echo "CLI の読み取りが約束にありません: $name" >&2
		return 1
	}
	if [[ $# == 1 ]]; then
		case $(jq -r '.command[0]' <<<"$entry") in
		gh) version=$(gh --version 2>/dev/null) || version= ;;
		*) version=$(multica version 2>/dev/null) || version= ;;
		esac
		version=${version%%$'\n'*}
	fi
	program=$(cat <<'PY'
import copy
import json
import os
import subprocess
import sys

name, entry, version = sys.argv[1], json.loads(sys.argv[2]), sys.argv[3]
errors = []
missing = object()

def get(value, path):
    for key in path:
        if not isinstance(value, dict) or key not in value:
            return missing
        value = value[key]
    return value

def matches(value, expression):
    result = subprocess.run(["jq", "-e", expression], input=json.dumps(value),
                            capture_output=True, text=True)
    if result.returncode not in (0, 1, 4):
        raise ValueError("約束の条件が不正です")
    return result.returncode == 0

def report(reason, field, value, index, when=None):
    identity = value.get("id", index) if isinstance(value, dict) else index
    context = (when + " のとき、" if when else "") + "要素 " + str(identity)
    suffix = "（" + version + "）" if version else ""
    errors.append(f"CLI の出力{reason}: {name} の {field}（{context}）{suffix}")

def project(value, tree):
    if not tree or not isinstance(value, dict):
        return copy.deepcopy(value)
    return {key: project(value[key], children) for key, children in tree.items() if key in value}

def normalize(value, schema, index, prefix=""):
    fields = schema.get("fields", [])
    if not isinstance(value, dict):
        report("の形が不正です", "object", value, index)
        return value
    tree = {}
    for field in fields:
        path = field["path"].split(".")
        node = tree
        for key in path:
            node = node.setdefault(key, {})
        when = field.get("when")
        required = field["class"] == "required" or (when is not None and matches(value, when))
        actual = get(value, path)
        if required and actual is missing:
            report("に欄がありません", prefix + field["path"], value, index, when)
        elif required and actual is None and not field["nullable"]:
            report("の欄が null です", prefix + field["path"], value, index, when)
    result = project(value, tree)
    child = schema.get("items")
    if child and (not child.get("when") or matches(value, child["when"])):
        path = child["path"]
        items = get(value, path)
        if items is not missing:
            if not isinstance(items, list):
                report("の形が不正です", prefix + ".".join(path), value, index)
            else:
                parent = get(result, path[:-1])
                if isinstance(parent, dict):
                    parent[path[-1]] = [normalize(item, child, position, prefix + ".".join(path) + "[].")
                                           for position, item in enumerate(items)]
    return result

try:
    decoder = json.JSONDecoder()
    text = sys.stdin.read().strip()
    pages = []
    while text:
        page, end = decoder.raw_decode(text)
        pages.append(page)
        text = text[end:].lstrip()
    if not pages or len(pages) > 1 and "pagination" not in entry:
        raise ValueError("応答の個数が不正です")
    normalized = []
    for page in pages:
        if entry["shape"] == "array":
            if not isinstance(page, list):
                raise ValueError("配列ではありません")
            normalized.append([normalize(item, entry["items"], index) for index, item in enumerate(page)])
        else:
            normalized.append(normalize(page, entry, 0))
    if entry.get("pagination", {}).get("kind") == "array":
        result = [item for page in normalized for item in page]
        value = [item for page in pages for item in page]
    else:
        result, value = normalized[0], copy.deepcopy(pages[0])
        path = entry.get("pagination", {}).get("path")
        if path and not errors:
            for target, source in [(result, normalized), (value, pages)]:
                get(target, path[:-1])[path[-1]] = [item for page in source for item in get(page, path)]
    if errors:
        print("\n".join(errors), file=sys.stderr)
        sys.exit(1)
    # テストだけで使う。検証は省かず、射影の前後で呼び出し元の動作を比べる。
    if os.environ.get("SQUAD_CLI_TEST_KEEP_FIELDS") == "1":
        result = value
    print(json.dumps(result, ensure_ascii=False))
except (ValueError, TypeError, KeyError) as error:
    print(f"CLI の出力を確かめられません: {name}（{error}）", file=sys.stderr)
    sys.exit(1)
PY
	) || return 1
	python3 -c "$program" "$name" "$entry" "$version"
}

# 約束のコマンドの {引数} を、記載順の位置引数で埋める。
# その後の引数は --limit などの追加オプション。JSON の出力指定は変更させない。
# 書き込みもここを通せるが、失敗した応答の検証を理由に投稿し直してはいけない。
squad_cli_read() {
	local name=$1 entry token raw status
	local -a command=()
	shift
	entry=$(squad_cli_contracts | jq -ce --arg name "$name" '.entries[$name] | select(. != null)') || {
		echo "CLI の読み取りが約束にありません: $name" >&2
		return 1
	}
	while IFS= read -r token; do
		if [[ $token == \{*\} ]]; then
			(($# > 0)) || { echo "CLI の読み取りの引数が足りません: $name の $token" >&2; return 1; }
			command+=("$1")
			shift
		else
			command+=("$token")
		fi
	done < <(jq -r '.command[]' <<<"$entry")
	for token in "$@"; do
		case $token in
		--compact|--compact=*|--output|--output=*|--json|--json=*)
			echo "CLI の JSON の出力指定は変更できません: $name の $token" >&2
			return 1 ;;
		esac
	done
	if raw=$("${command[@]}" "$@"); then
		printf '%s\n' "$raw" | squad_cli_normalize "$name"
	else
		status=$?
		return "$status"
	fi
}

# 回を書いた進行役をリーダーとする、有効なスクワッドを 1 つだけ返す。
# review-wait と PR の見張りで、同じ選び方を使う。
# 候補が 0 件・複数なら 2、CLI・欄の検証の失敗なら 1 を返す。
squad_cli_squad_for_leader() {
	local leader=$1 squads matches count
	squads=$(squad_cli_read squad-list) || return 1
	matches=$(jq --arg leader "$leader" '[.[] | select(.leader_id == $leader and .archived_at == null)]' <<<"$squads") || return 1
	count=$(jq length <<<"$matches") || return 1
	if [[ $count != 1 ]]; then
		printf '知らせるスクワッドを決められません: %s 件（回を書いたエージェント %s）\n' "$count" "$leader" >&2
		return 2
	fi
	jq '.[0]' <<<"$matches"
}
