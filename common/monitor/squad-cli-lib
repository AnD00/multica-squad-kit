# JSON の応答を検証・整形する。第 2 引数は、テストなどで固定する CLI のバージョン。
# 入力の検証がすべて済むまで標準出力には何も返さない。
squad_cli_normalize() {
	local name=$1 entry
	entry=$(squad_cli_contracts | jq -ce --arg name "$name" '.entries[$name] | select(. != null)') || {
		echo "CLI の読み取りが約束にありません: $name" >&2
		return 1
	}
	if [[ $# == 1 ]]; then
		squad_cli_check_entry "$name" "$entry"
	else
		squad_cli_check_entry "$name" "$entry" "$2"
	fi
}

# 取り出した約束の項目で、標準入力の JSON を検証・整形する。
# 第 3 引数のバージョンを省くと、欄が欠けて失敗するメッセージを作るときだけ、実物の CLI から読む。
squad_cli_check_entry() {
	local name=$1 entry=$2 version=${3-} mode=fixed program
	(($# >= 3)) || mode=read
	program=$(cat <<'PY'
import copy
import json
import os
import subprocess
import sys

name, entry, version, mode = sys.argv[1], json.loads(sys.argv[2]), sys.argv[3], sys.argv[4]
errors = []
missing = object()

def cli_version():
    global version, mode
    if mode == "read":
        mode = "fixed"
        command = {"gh": ["gh", "--version"], "codex": ["codex", "--version"]}.get(
            (entry.get("command") or [None])[0], ["multica", "version"])
        try:
            result = subprocess.run(command, stdin=subprocess.DEVNULL, capture_output=True,
                                    text=True, errors="replace")
            version = result.stdout.split("\n")[0] if result.returncode == 0 else ""
        except OSError:
            version = ""
    return version

def get(value, path):
    for key in path:
        if not isinstance(value, dict) or key not in value:
            return missing
        value = value[key]
    return value

def matches(value, expression):
    result = subprocess.run(["jq", "-e", expression], input=json.dumps(value),
                            capture_output=True, text=True)
    if result.returncode not in (0, 1, 4):
        raise ValueError("約束の条件が不正です")
    return result.returncode == 0

def report(reason, field, value, index, when=None):
    identity = value.get("id", index) if isinstance(value, dict) else index
    context = (when + " のとき、" if when else "") + "要素 " + str(identity)
    suffix = "（" + cli_version() + "）" if cli_version() else ""
    errors.append(f"CLI の出力{reason}: {name} の {field}（{context}）{suffix}")

def project(value, tree):
    if not tree or not isinstance(value, dict):
        return copy.deepcopy(value)
    return {key: project(value[key], children) for key, children in tree.items() if key in value}

def normalize(value, schema, index, prefix=""):
    fields = schema.get("fields", [])
    if not isinstance(value, dict):
        report("の形が不正です", "object", value, index)
        return value
    tree = {}
    for field in fields:
        path = field["path"].split(".")
        node = tree
        for key in path:
            node = node.setdefault(key, {})
        when = field.get("when")
        required = field["class"] == "required" or (when is not None and matches(value, when))
        actual = get(value, path)
        if required and actual is missing:
            report("に欄がありません", prefix + field["path"], value, index, when)
        elif required and actual is None and not field["nullable"]:
            report("の欄が null です", prefix + field["path"], value, index, when)
    result = project(value, tree)
    mapping = schema.get("values")
    if mapping:
        path = mapping["path"]
        values = get(value, path)
        if values is not missing:
            if not isinstance(values, dict):
                report("の形が不正です", prefix + ".".join(path), value, index)
            else:
                parent = get(result, path[:-1])
                if isinstance(parent, dict):
                    parent[path[-1]] = {key: normalize(item, mapping, key, prefix + ".".join(path) + "." + key + ".")
                                          for key, item in values.items()}
    child = schema.get("items")
    if child and (not child.get("when") or matches(value, child["when"])):
        path = child["path"]
        items = get(value, path)
        if items is not missing:
            if not isinstance(items, list):
                report("の形が不正です", prefix + ".".join(path), value, index)
            else:
                parent = get(result, path[:-1])
                if isinstance(parent, dict):
                    parent[path[-1]] = [normalize(item, child, position, prefix + ".".join(path) + "[].")
                                           for position, item in enumerate(items)]
    return result

try:
    decoder = json.JSONDecoder()
    text = sys.stdin.read().strip()
    pages = []
    while text:
        page, end = decoder.raw_decode(text)
        pages.append(page)
        text = text[end:].lstrip()
    if not pages or len(pages) > 1 and "pagination" not in entry:
        raise ValueError("応答の個数が不正です")
    normalized = []
    for page in pages:
        if entry["shape"] == "array":
            if not isinstance(page, list):
                raise ValueError("配列ではありません")
            normalized.append([normalize(item, entry["items"], index) for index, item in enumerate(page)])
        else:
            normalized.append(normalize(page, entry, 0))
    if entry.get("pagination", {}).get("kind") == "array":
        result = [item for page in normalized for item in page]
        value = [item for page in pages for item in page]
    else:
        result, value = normalized[0], copy.deepcopy(pages[0])
        path = entry.get("pagination", {}).get("path")
        if path and not errors:
            for target, source in [(result, normalized), (value, pages)]:
                get(target, path[:-1])[path[-1]] = [item for page in source for item in get(page, path)]
    if errors:
        print("\n".join(errors), file=sys.stderr)
        sys.exit(1)
    # テストだけで使う。検証は省かず、射影の前後で呼び出し元の動作を比べる。
    if os.environ.get("SQUAD_CLI_TEST_KEEP_FIELDS") == "1":
        result = value
    print(json.dumps(result, ensure_ascii=False))
except (ValueError, TypeError, KeyError) as error:
    print(f"CLI の出力を確認できません: {name}（{error}）", file=sys.stderr)
    sys.exit(1)
PY
	) || return 1
	python3 -c "$program" "$name" "$entry" "$version" "$mode"
}

# Codex: app-server の account/rateLimits/read を呼び、応答の .result を 1 行の JSON で出す。
# モデルを呼ばないので、使用量を消費しない。
# app-server は stdin が閉じると終わるので、応答が来るか 30 秒たつまで、stdin を開けたまま待つ。
squad_cli_codex_usage() {
	local out_file
	mkdir -p "$PWD/tmp" || return 1
	out_file=$(mktemp "$PWD/tmp/squad-codex.XXXXXX") || return 1
	{
		printf '%s\n' \
			'{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"clientInfo":{"name":"squad-usage-check","version":"1.0.0"}}}' \
			'{"jsonrpc":"2.0","method":"initialized"}' \
			'{"jsonrpc":"2.0","id":2,"method":"account/rateLimits/read"}'
		for _ in $(seq 30); do
			grep -q '"id":2' "$out_file" && break
			sleep 1
		done
	} | codex app-server >"$out_file" 2>/dev/null || true

	local res
	res=$(jq -c 'select(.id == 2)' "$out_file" 2>/dev/null || true)
	rm -f "$out_file"
	if [[ -z "$res" ]]; then
		echo "codex app-server から使用量の応答がなかった" >&2
		return 1
	fi
	if ! jq -e '.result' <<<"$res" >/dev/null; then
		echo "codex app-server がエラーを返した: $(jq -r '.error.message // .' <<<"$res")" >&2
		return 1
	fi
	jq -c '.result' <<<"$res"
}

# 約束のコマンドの {引数} を、記載順の位置引数で埋める。
# その後の引数は --limit などの追加オプション。JSON の出力指定は変更させない。
# 書き込みもここを通せるが、失敗した応答の検証を理由に投稿し直してはいけない。
squad_cli_read() {
	local name=$1 entry token raw status
	local -a command=()
	shift
	# 約束の項目（1 行目）と、そのコマンド（2 行目以降）を、1 回の jq でまとめて取り出す。
	{
		IFS= read -r entry
		if [[ -z $entry ]]; then
			echo "CLI の読み取りが約束にありません: $name" >&2
			return 1
		fi
		# app-server は CLI の位置引数でなく、初期化後の JSON-RPC で問い合わせる。
		if [[ $name == codex-rate-limits ]]; then
			(($# == 0)) || { echo 'Codex の使用量の読み取りに追加の引数は渡せません' >&2; return 1; }
			command=(squad_cli_codex_usage)
		else
		while IFS= read -r token; do
			if [[ $token == \{*\} ]]; then
				(($# > 0)) || { echo "CLI の読み取りの引数が足りません: $name の $token" >&2; return 1; }
				command+=("$1")
				shift
			else
				command+=("$token")
			fi
		done
		fi
	} < <(squad_cli_contracts | jq -rc --arg name "$name" '.entries[$name] | select(. != null) | ., .command[]')
	for token in "$@"; do
		case $token in
		--compact|--compact=*|--output|--output=*|--json|--json=*)
			echo "CLI の JSON の出力指定は変更できません: $name の $token" >&2
			return 1 ;;
		esac
	done
	if raw=$("${command[@]}" "$@"); then
		printf '%s\n' "$raw" | squad_cli_check_entry "$name" "$entry"
	else
		status=$?
		return "$status"
	fi
}

# 回を書いた役をリーダーとする、有効なスクワッドを 1 つだけ返す。
# review-wait と PR の見張りで、同じ選び方を使う。
# 候補が 0 件・複数なら 2、CLI・欄の検証の失敗なら 1 を返す。
squad_cli_squad_for_leader() {
	local leader=$1 squads matches count
	squads=$(squad_cli_read squad-list) || return 1
	matches=$(jq --arg leader "$leader" '[.[] | select(.leader_id == $leader and .archived_at == null)]' <<<"$squads") || return 1
	count=$(jq length <<<"$matches") || return 1
	if [[ $count != 1 ]]; then
		printf '知らせるスクワッドを決められません: %s 件（回を書いたエージェント %s）\n' "$count" "$leader" >&2
		return 2
	fi
	jq '.[0]' <<<"$matches"
}

# 回を書いたコメントから、知らせるスクワッドを JSON で出す。
# 回を書いたエージェントがリーダーのスクワッドがあれば、それを使う。なければ、次の依頼のように役が書いた回なので、
# `前の回:` をたどって（同じタスクのコメントだけ。10 回まで）、リーダーが書いた回のスクワッドを使う。
# 決められなければ 2、CLI・欄の検証の失敗なら 1 を返す。review-wait・次の依頼の決定・使用率の待ちが同じ決め方を使う。
squad_cli_squad_for_round() {
	local comments=$1 current=$2 squads hop comment author matches count mark='前の回:'
	squads=$(squad_cli_read squad-list) || return 1
	for ((hop = 0; hop <= 10; hop++)); do
		comment=$(jq -c --arg id "$current" '[.[] | select(.id == $id)] | first // {}' <<<"$comments") || return 1
		author=$(jq -r '.author_id // empty' <<<"$comment") || return 1
		[[ -n $author ]] || break
		matches=$(jq -c --arg leader "$author" '[.[] | select(.leader_id == $leader and .archived_at == null)]' <<<"$squads") || return 1
		count=$(jq length <<<"$matches") || return 1
		if ((count == 1)); then
			jq '.[0]' <<<"$matches"
			return 0
		fi
		if ((count > 1)); then
			printf '知らせるスクワッドを決められません: %s 件（回を書いたエージェント %s）\n' "$count" "$author" >&2
			return 2
		fi
		current=$(jq -r --arg mark "$mark" '(.content // "") | split("\n") | map(select(startswith($mark))) | first // "" | ltrimstr($mark) | gsub("^\\s+|\\s+$"; "")' <<<"$comment") || return 1
		[[ -n $current ]] || break
	done
	printf '知らせるスクワッドを決められません: 回を書いたエージェント %s はどのスクワッドのリーダーでもなく、`前の回:` をたどってもリーダーの回に着きません\n' "${author:-不明}" >&2
	return 2
}

# 制御記録と認める回の判定。review-next・review-wait・pr-watch が同じ判定を使う（docs/review-next-step.md の「制御記録の読み方」）。
# 名簿は読まない。リーダーの ID の一覧と、必要なら名簿の最上位の役の ID の一覧を、呼び出し側が渡す。
# 標準入力に {comments, leaders, principals} を渡し、モードで出すものを変える。
#   analyze: 各コメントの {rounds, controls, finals}。finals は principals があるときだけ。
#   merge_requested <head>: その head のマージの依頼があれば yes、なければ no。
#   state: 認める回のうち最も新しいものの状態（なければ何も出さない）。
read -r -d '' SQUAD_CLI_CONTROL_PY <<'SQUADCLICONTROLPY' || true
import calendar
import json
import re
import sys

mode = sys.argv[1]
args = sys.argv[2:]
data = json.load(sys.stdin)
comments = [c for c in (data.get("comments") or []) if isinstance(c, dict) and c.get("id")]
leaders = set(data.get("leaders") or [])
principals = data.get("principals")

ROUND = "返事を待つ役:"
RESULT = "返事の回:"
PREV = "前の回:"
CLAIM = "返事の待ち: この回を次へ回します"
DECIDE = "返事の待ち: 次の依頼を決めます"
READY = "返事がそろいました"
MAX_HOPS = 10
WRITTEN = {"retry", "fix", "final", "merge", "human"}
STAMP = re.compile(r"^(\d{4})-(\d\d)-(\d\d)[T ](\d\d):(\d\d):(\d\d)(?:\.(\d+))?\s*(Z|[+-]\d\d(?::?\d\d)?)?$")


def stamp(text):
    """時刻をナノ秒の整数にする。読めなければ 0。小数の桁数と Z・オフセットの形を問わない。"""
    found = STAMP.match(str(text or "").strip())
    if not found:
        return 0
    year, month, day, hour, minute, second = (int(found.group(k)) for k in range(1, 7))
    value = calendar.timegm((year, month, day, hour, minute, second)) * 10**9
    if found.group(7):
        value += int(found.group(7).ljust(9, "0")[:9])
    zone = found.group(8)
    if zone and zone != "Z":
        digits = zone[1:].replace(":", "")
        offset = int(digits[:2]) * 3600 + (int(digits[2:4]) * 60 if len(digits) >= 4 else 0)
        value -= (-1 if zone[0] == "-" else 1) * offset * 10**9
    return value


def parse(comment):
    """行の置き方を満たす行（placed）と、囲みや引用を問わない全部の行（every）を返す。"""
    placed, every, fence = [], [], None
    for raw in (comment.get("content") or "").split("\n"):
        line = raw.rstrip()
        if line == "/note":
            continue
        if line.startswith("/note "):
            line = line[6:].rstrip()
        every.append(line)
        bare = line.strip()
        if fence is not None:
            # 囲みを閉じるのは、開始と同じ種類で、開始以上の長さの行だけ。短い囲みや別の種類は、囲みの中の行として読み飛ばす。
            if len(bare) >= fence[1] and set(bare) == {fence[0]}:
                fence = None
            continue
        run = len(bare) - len(bare.lstrip(bare[:1])) if bare[:1] in ("`", "~") else 0
        if run >= 3:
            fence = (bare[0], run)
            continue
        if line and not line[0].isspace() and not line.startswith(">"):
            placed.append(line)
    return placed, every


parsed = {}
for comment in comments:
    placed, every = parse(comment)
    parsed[comment["id"]] = {
        "agent": comment.get("author_type") == "agent",
        "author": comment.get("author_id"),
        "placed": placed,
        "every": every,
        "ns": stamp(comment.get("created_at")),
        "first_line": (comment.get("content") or "").split("\n")[0],
    }
order = sorted(range(len(comments)), key=lambda k: (parsed[comments[k]["id"]]["ns"], k))
sequence = [comments[k]["id"] for k in order]
pos = {key: rank for rank, key in enumerate(sequence)}


def field(i, prefix):
    for line in parsed[i]["placed"]:
        if line.startswith(prefix):
            return line[len(prefix):].strip()
    return None


def has(i, prefix):
    return any(line.startswith(prefix) for line in parsed[i]["placed"])


def is_result(i):
    # 結果の行は囲みの中でも読む。囲みを閉じない結果で、結果でないものとして扱われないようにするため。
    return any(line.startswith(RESULT) for line in parsed[i]["every"])


def prev_of(i):
    """(`前の回:` の指す ID か None, 行があるか)。行は `前の回: <ID>` のとおりに完全に一致するものだけ。"""
    for line in parsed[i]["placed"]:
        if line.startswith(PREV):
            found = re.fullmatch(r"前の回: (\S+)", line)
            return (found.group(1) if found else None), True
    return None, False


def mentions(i):
    for line in parsed[i]["placed"]:
        if line.startswith(ROUND):
            return re.findall(r"mention://agent/([A-Za-z0-9-]+)", line)
    return []


def waited(i):
    found = []
    for value in mentions(i):
        if value not in found:
            found.append(value)
    return found


def round_kind(i):
    value = field(i, "見直しの種類:")
    if value is not None:
        if value.startswith("最終レビュー"):
            return "final"
        if value.startswith(("設計の見直し", "設計と PR の見直し")):
            return "design"
        return "unknown"
    if has(i, "観点:") or has(i, "コミットが合わず頼み直す役:"):
        return "review"
    return "unknown"


def control_kind(i):
    if has(i, "コミットが合わず頼み直す役:"):
        return "retry"
    if has(i, "修正の依頼:"):
        return "fix"
    if has(i, "見直しの種類: 最終レビュー"):
        return "final"
    if has(i, "マージの依頼:"):
        return "merge"
    usage = [line for line in parsed[i]["placed"] if line.startswith("使用率の待ち:")]
    if usage:
        return "human" if any("24 時間を超える" in line for line in usage) else "usage"
    if has(i, "マージの前の CI の待ち:"):
        return "ci"
    return None


decide_cache = {}


def decide_role(i):
    """回の決める実行の役: (作者の ID, 決める記録のコメント)。回の返事を待つ役が、回より後に書いた最も早い決める記録。"""
    if i not in decide_cache:
        roles = waited(i)
        records = sorted(
            (parsed[j]["ns"], j) for j in sequence
            if parsed[j]["agent"] and parsed[j]["author"] in roles and pos[j] > pos[i]
            and not is_result(j) and has(j, DECIDE)
        )
        decide_cache[i] = (parsed[records[0][1]]["author"], records[0][1]) if records else None
    return decide_cache[i]


recognize_cache = {}
control_cache = {}


def recognize(i):
    """認める回か。(はい・いいえ, 当たらなかった条件, 連鎖の長さ)。"""
    if i not in recognize_cache:
        recognize_cache[i] = (False, "回をたどる途中で循環した", 0)
        recognize_cache[i] = recognize_now(i)
    return recognize_cache[i]


def recognize_now(i):
    data_i = parsed[i]
    if not data_i["agent"]:
        return False, "作者がエージェントでない", 0
    if not waited(i):
        return False, "返事を待つ役: の行が行の置き方を満たさないか、エージェントのメンションがない", 0
    if is_result(i):
        return False, "返事の回: の行がある（役の結果）", 0
    if data_i["author"] in leaders:
        return True, "", 0
    pid, present = prev_of(i)
    if pid is None:
        return False, "作者がリーダーでなく、前の回: の行が" + ("読めない" if present else "ない"), 0
    ctl = control(i)
    if ctl["kind"] not in ("retry", "final") or ctl.get("role") != "decide":
        return False, ctl["reason"] or "頼み直しか最終レビューの依頼の制御記録でない", 0
    hops = recognize(pid)[2] + 1
    if hops > MAX_HOPS:
        return False, f"前の回を {MAX_HOPS} 回までにたどりきれない", hops
    return True, "", hops


def control(i):
    """制御記録の条件のすべてを確かめる。{kind, prev, role, reason}。kind が None なら制御記録でない。"""
    if i not in control_cache:
        control_cache[i] = control_now(i)
    return control_cache[i]


def control_now(i):
    def no(reason):
        return {"kind": None, "reason": reason}

    data_i = parsed[i]
    if not data_i["agent"]:
        return no("作者がエージェントでない")
    if is_result(i):
        return no("返事の回: の行がある（役の結果）")
    pid, present = prev_of(i)
    if pid is None:
        return no("前の回: の行が" + ("読めない" if present else "ない"))
    if pid not in parsed:
        return no("前の回: が同じタスクのコメントを指さない")
    kind = control_kind(i)
    if kind is None:
        return no("制御記録の種類を示す行がない")
    if pos[i] <= pos[pid]:
        return no("指す回より後に書かれていない")
    ok, why, _ = recognize(pid)
    if not ok:
        return no(f"指す回を認められない（{why}）")
    if round_kind(pid) not in ("review", "final"):
        return no("指す回がレビューと E2E の回でも最終レビューの回でもない")
    if data_i["author"] in leaders:
        return {"kind": kind, "prev": pid, "role": "leader", "reason": ""}
    role = decide_role(pid)
    if role is None or role[0] != data_i["author"]:
        return no("作者が指す回の決める実行の役でもリーダーでもない")
    if pos[i] <= pos[role[1]]:
        return no("決める記録より後に書かれていない")
    return {"kind": kind, "prev": pid, "role": "decide", "reason": ""}


def final_check(i):
    """最終レビューの回の候補が、認める条件に当たるか。(はい・いいえ, 当たらなかった条件)。"""
    author = parsed[i]["author"]
    pid, present = prev_of(i)
    role = decide_role(pid) if pid in parsed else None
    if author not in leaders and not (role and author == role[0] and pos[i] > pos[role[1]]):
        return False, "作者がリーダーでも前の回の決める実行の役でもない"
    if pid is None or pid not in parsed:
        return False, "前の回: の行がないか、同じタスクのコメントを指さない"
    ok, why, _ = recognize(pid)
    if not ok or round_kind(pid) != "review" or pos[i] <= pos[pid]:
        return False, "前の回がレビューと E2E の認める回でないか、前の回より後に書かれていない"
    found = mentions(i)
    if len(found) != 1 or found[0] not in principals:
        return False, "返事を待つ役が名簿の最上位の役 1 つだけでない"
    commit = field(i, "確認するコミット:")
    if not commit or commit != field(pid, "確認するコミット:"):
        return False, "確認するコミット: が前の回と違う"
    ok, why, _ = recognize(i)
    if not ok:
        return False, f"回として認められない（{why}）"
    return True, ""


def emit(value):
    print(json.dumps(value, ensure_ascii=False, separators=(",", ":")))


if mode == "analyze":
    rounds, controls, finals = {}, [], {}
    for i in sequence:
        ok, why, _ = recognize(i)
        pid, present = prev_of(i)
        rounds[i] = {
            "ok": ok, "reason": why, "kind": round_kind(i), "waited": waited(i),
            "prev": pid, "prev_line": present, "has_kind_line": field(i, "見直しの種類:") is not None,
        }
        ctl = control(i)
        if ctl["kind"]:
            controls.append({"id": i, "prev": ctl["prev"], "kind": ctl["kind"], "role": ctl["role"], "written": ctl["kind"] in WRITTEN})
        if principals is not None and parsed[i]["agent"] and not is_result(i) and (field(i, "見直しの種類:") or "").startswith("最終レビュー"):
            ok, why = final_check(i)
            finals[i] = {"ok": ok, "reason": why, "commit": field(i, "確認するコミット:")}
    emit({"rounds": rounds, "controls": controls, "finals": finals})
elif mode == "merge_requested":
    want = "マージの依頼: " + args[0]
    for i in sequence:
        if not parsed[i]["agent"] or is_result(i) or want not in parsed[i]["placed"]:
            continue
        if parsed[i]["author"] in leaders or control(i)["kind"] == "merge":
            print("yes")
            sys.exit(0)
    print("no")
elif mode == "state":
    found = [i for i in sequence if parsed[i]["agent"] and recognize(i)[0]]
    if found:
        r = found[-1]
        roles = sorted(set(waited(r)))
        after = [j for j in sequence if pos[j] > pos[r]]
        agents = [j for j in after if parsed[j]["agent"]]
        records = sorted((parsed[j]["ns"], j) for j in agents if parsed[j]["author"] in roles and not is_result(j) and has(j, DECIDE))
        sort = lambda ids: [j for _, j in sorted((parsed[j]["ns"], j) for j in ids)]
        ready_ids = sort(j for j in agents if READY in parsed[j]["first_line"])
        emit({
            "id": r, "author_id": parsed[r]["author"], "ts": parsed[r]["ns"] / 1e9, "waiting": roles,
            "returned": sorted({parsed[j]["author"] for j in agents if parsed[j]["author"] in roles}),
            "ready_ids": ready_ids,
            "claim_ids": sort(j for j in agents if not is_result(j) and has(j, CLAIM)),
            "decide_ids": [j for _, j in records],
            "decide_ts": records[0][0] / 1e9 if records else None,
            "next_ids": sort(j for j in agents if control(j)["kind"] and control(j)["prev"] == r),
            "ready": bool(ready_ids),
        })
else:
    print("mode が不正", file=sys.stderr)
    sys.exit(1)
SQUADCLICONTROLPY

# squad_cli_control <モード> <コメントの JSON> <リーダーの ID の JSON 配列> <最上位の役の ID の JSON 配列か null> [<モードの引数>...]
squad_cli_control() {
	local mode=$1 comments=$2 leaders=$3 principals=$4
	shift 4
	jq -c --argjson leaders "$leaders" --argjson principals "$principals" \
		'{comments: ., leaders: $leaders, principals: $principals}' <<<"$comments" \
		| python3 -I -c "$SQUAD_CLI_CONTROL_PY" "$mode" "$@"
}

# 呼び出したリーダー（MULTICA_AGENT_ID）がリーダーのスクワッドの名簿を読む。回のコメントがない直接の呼び出し（request と pick）が使う。
# タスクの担当がメンバーでも、オートパイロットのタスクでも、呼び出したリーダーのスクワッドで読める。
# MULTICA_AGENT_ID がないか、そのエージェントがどのスクワッドのリーダーでもない（候補が 0 件・複数）ときだけ、タスクの担当のスクワッドへ戻る。
# CLI・欄の検証の失敗は、戻らずに 1 を返す。
squad_cli_read_roster_for_caller() {
	local issue=$1 caller=${MULTICA_AGENT_ID:-} squad status
	if [[ -n $caller ]]; then
		if squad=$(squad_cli_squad_for_leader "$caller" 2>/dev/null); then
			squad_cli_read_roster "$issue" "$(jq -r .id <<<"$squad")"
			return
		else
			status=$?
			((status == 2)) || return "$status"
		fi
	fi
	squad_cli_read_roster "$issue"
}

# エージェントの名前（<プロジェクトのキー>-<役>-<メンバーのキー>）から、このスクワッドの役を読む。
# キーに - は入らないので、スクワッドの名前（キーとメンバーのキーを - でつなぎ大文字にしたもの）と
# 先頭・末尾が合う名前の、間を役とする。アーカイブ済みのエージェントとキーが合わないものは入れない。
# {leader, roles: {<役>: {id, model, name}}} を出す。見張りと次の依頼の決定が同じ名簿を使う。
# 2 つ目の引数にスクワッドの ID があれば、そのスクワッドの名簿を読む（回から決めたスクワッド）。
# なければ、タスクの担当のスクワッドを使う。
squad_cli_read_roster() {
	local issue=$1 squad_id=${2-} task squads squad key member members ids id agent roles='{}' name role
	if [[ -z $squad_id ]]; then
		task=$(squad_cli_read issue-get "$issue") || return 1
		squad_id=$(jq -r 'if .assignee_type == "squad" then .assignee_id else "" end' <<<"$task")
		if [[ -z $squad_id ]]; then
			echo "タスクの担当がスクワッドではないため、名簿を読めない: $issue" >&2
			return 1
		fi
	fi
	squads=$(squad_cli_read squad-list) || return 1
	squad=$(jq -c --arg id "$squad_id" '[.[] | select(.id == $id and .archived_at == null)] | first // empty' <<<"$squads") || return 1
	if [[ -z $squad ]]; then
		echo "タスクの担当のスクワッドが一覧にない、またはアーカイブ済み: $squad_id" >&2
		return 1
	fi
	if ! jq -e '.name | ascii_downcase | split("-") | length == 2' <<<"$squad" >/dev/null; then
		echo 'スクワッドの名前から、キーとメンバーのキーを読めない' >&2
		return 1
	fi
	key=$(jq -r '.name | ascii_downcase | split("-")[0]' <<<"$squad")
	member=$(jq -r '.name | ascii_downcase | split("-")[1]' <<<"$squad")
	members=$(squad_cli_read squad-member-list "$squad_id") || return 1
	ids=$(jq -r '.[] | select(.member_type == "agent") | .member_id' <<<"$members")
	while IFS= read -r id; do
		[[ -n $id ]] || continue
		agent=$(squad_cli_read agent-get "$id") || return 1
		role=$(jq -r --arg key "$key" --arg member "$member" '
			select(.archived_at == null)
			| (.name | ascii_downcase) as $name
			| if ($name | startswith($key + "-")) and ($name | endswith("-" + $member))
				and ($name | length) > ($key | length) + ($member | length) + 2
			then $name[($key | length) + 1:-(($member | length) + 1)] else empty end' <<<"$agent") || return 1
		[[ -n $role ]] || continue
		roles=$(jq -c --arg role "$role" --argjson agent "$agent" \
			'if has($role) then . else .[$role] = {id: $agent.id, model: $agent.model, name: $agent.name} end' <<<"$roles")
	done <<<"$ids"
	jq -cn --argjson squad "$squad" --argjson roles "$roles" '{leader: $squad.leader_id, roles: $roles}'
}
