#!/usr/bin/env bash
# multica-squad-kit-managed
# PR を作った直後に呼ぶ。紐付けに失敗しても、役は止まらずに引き継ぐ。
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/squad-pr-link-lib"
source "$(dirname "${BASH_SOURCE[0]}")/squad-cli-lib"

if [[ $# != 2 || -z $1 || ! $2 =~ ^https://github\.com/[A-Za-z0-9_-]+/[A-Za-z0-9_.-]+/pull/[0-9]+$ ]]; then
	echo '使い方: squad-pr-link <タスク> <PR の URL (https://github.com/OWNER/REPO/pull/番号)>' >&2
	exit 2
fi
task=$1 url=$2 identifier=$1
warn() {
	printf 'タスク %s に PR %s を紐付けられませんでした（%s）。タスクの画面の PR の欄で、この URL を指定して紐付けてください。\n' "$identifier" "$url" "$1" >&2
}
# 404 で待ち切れたときだけ、連携と同期の確認を案内する。
warn_not_found() {
	local repository=${url#https://github.com/}
	repository=${repository%/pull/*}
	printf 'サーバーは、%s がワークスペースの GitHub 連携につながり、PR が同期されるまで、PR を見つけられません。ワークスペースの設定のコードの画面で、%s がつながっていることを確かめてから紐付けてください。つながっていないと、タスクの画面からも紐付けられません。\n' "$repository" "$repository" >&2
}

mkdir -p tmp
diagnostic=$(mktemp tmp/pr-link-read.XXXXXX)
trap "$(printf 'rm -f -- %q' "$diagnostic")" EXIT
if ! issue=$(squad_cli_read issue-get "$task" 2>"$diagnostic"); then
	# CLI 自体の診断には認証情報が含まれ得る。約束の欄の診断だけを返す。
	sed -n '/^CLI の出力/p' "$diagnostic" >&2
	warn 'タスクを読めない'
	exit 1
fi
rm -f "$diagnostic"
trap - EXIT
if ! jq -e '(.id | type == "string" and length > 0)
	and (.identifier | type == "string" and length > 0)
	and (.metadata | type == "object")' <<<"$issue" >/dev/null; then
	warn 'タスクを読めない'
	exit 1
fi
id=$(jq -r '.id' <<<"$issue")
identifier=$(jq -r '.identifier' <<<"$issue")
metadata=$(jq -c '.metadata' <<<"$issue")
if ! pr_link_pull_request "$id" "$url" "$metadata"; then
	warn "$PR_LINK_REASON"
	if [[ ${PR_LINK_NOT_FOUND:-0} == 1 ]]; then warn_not_found; fi
	exit 1
fi
if jq -e 'has("pr_url")' <<<"$metadata" >/dev/null; then
	existing_url=$(jq -r '.pr_url' <<<"$metadata")
	if [[ $existing_url != "$url" ]]; then
		printf 'タスク %s の metadata の pr_url は PR %s と違うため、紐付けは変えません。\n' "$identifier" "$url" >&2
	fi
	printf '紐付けていません: %s %s（metadata に pr_url があるため、API を呼びませんでした。紐付いているかは multica issue pull-requests で確かめてください）\n' "$identifier" "$url"
else
	printf '紐付けました: %s %s\n' "$identifier" "$url"
fi
