#!/usr/bin/env bash
# multica-squad-kit-managed
# Dependabot の週次の確認で、判断の要らない処理を行う。
#   squad-dependabot-merge <OWNER/REPO> <プロジェクト ID> list — 開いている PR の更新の種類と必須 CI を JSON で返す。
#   squad-dependabot-merge <OWNER/REPO> <プロジェクト ID> advance <PR> --reviewed-head <SHA> --run-deadline <epoch> [--retry]
#   squad-dependabot-merge <OWNER/REPO> <プロジェクト ID> escalate <PR> <本文のファイル> --assignee <名前>
# macOS の bash 3.2 でも動くよう、連想配列は使わない。
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/squad-pr-link-lib"
source "$(dirname "${BASH_SOURCE[0]}")/squad-cli-lib"

RUN_SECONDS=14400

usage() {
	echo '使い方: squad-dependabot-merge <OWNER/REPO> <プロジェクト ID> list | advance <PR> --reviewed-head <SHA> --run-deadline <epoch> [--retry] | escalate <PR> <本文のファイル> --assignee <名前>' >&2
	exit 2
}

# Dependabot が生成する YAML の決まった行だけを読む。一般の YAML として
# 解釈できない形式や、グループ内に update-type のない依存があれば major に倒す。
update_type() {
	local message=$1 ecosystem=$2 files=$3
	jq -nr --arg message "$message" --arg ecosystem "$ecosystem" --argjson files "$files" '
		def digest_only:
			length > 0 and all(.[];
				.status == "modified" and (.patch | type) == "string"
				and ([.patch | split("\n")[] | select(startswith("-"))] | length) == .deletions
				and ([.patch | split("\n")[] | select(startswith("+"))] | length) == .additions
				and .additions > 0 and .additions == .deletions
				and ([.patch | split("\n")[] | select(test("^[+-]"))]
					| all(.[]; test("^[+-]\\s*(FROM\\s|image:)"; "i")
						and ([scan("@sha256:[a-fA-F0-9]{64}")] | length) == 1))
				and ([.patch | split("\n")[] | select(startswith("-")) | .[1:]
					| sub("@sha256:[a-fA-F0-9]{64}"; "@sha256:<digest>")] | sort)
				== ([.patch | split("\n")[] | select(startswith("+")) | .[1:]
					| sub("@sha256:[a-fA-F0-9]{64}"; "@sha256:<digest>")] | sort));
		("\n" + $message + "\n" | split("\n---\nupdated-dependencies:\n")) as $blocks
		| (if ($blocks | length) == 2 and ($blocks[1] // "" | split("\n...\n") | length) == 2 then
			$blocks[1] | split("\n...\n")[0] | split("\n")
			| reduce .[] as $line ({deps: [], bad: false};
				if $line | test("^- dependency-name: .+$") then .deps += [[]]
				elif ($line | startswith("  ")) and (.deps | length) > 0 then .deps[-1] += [$line]
				elif $line == "" then .
				else .bad = true end)
		else {deps: [], bad: true} end) as $metadata
		| [$metadata.deps[] | [.[] | select(startswith("  update-type:"))
			| sub("^  update-type: *"; "")]
			| if length == 1 then .[0] elif length == 0 then null else "invalid" end] as $types
		| if ($types | length) > 0 and ($metadata.bad | not)
			and all($types[]; . == "version-update:semver-patch" or . == "version-update:semver-minor" or . == "version-update:semver-major") then
			if $types | index("version-update:semver-major") then "major"
			elif $types | index("version-update:semver-minor") then "minor"
			else "patch" end
		elif ($types | all(. == null))
			and ($ecosystem == "docker" or $ecosystem == "docker-compose") and ($files | digest_only) then "patch"
		else "major" end'
}

required_ci() {
	local required=$1 checks=$2 statuses=$3
	jq -nr --argjson required "$required" --argjson checks "$checks" --argjson statuses "$statuses" '
		# 同じ名前・App の再実行は最新の ID を使い、前の成功を拾わない。
		($checks | group_by([.name, .app.id]) | map(max_by(.id))) as $latest
		| ($statuses | group_by(.context) | map(max_by(.id))) as $latest_statuses
		| [$required[] as $rule
			| ([$latest[] | select(.name == $rule.context and
				($rule.integration_id == null or $rule.integration_id == .app.id))
				| if .status != "completed" then "pending"
				  elif .conclusion == "success" then "success"
				  else "failure" end]
				+ [$latest_statuses[] | select(.context == $rule.context and $rule.integration_id == null)
					| if .state == "success" then "success"
					  elif .state == "failure" or .state == "error" then "failure"
					  else "pending" end]) as $results
			| if $results | index("failure") then "failure"
			  elif ($results | length) == 0 or ($results | index("pending")) then "pending"
			  else "success" end]
		| if index("failure") then "failure"
		  elif index("pending") then "pending"
		  else "success" end'
}

ecosystem_of() {
	case $1 in
	dependabot/go_modules/*) echo gomod ;;
	dependabot/npm_and_yarn/*) echo npm ;;
	dependabot/github_actions/*) echo github-actions ;;
	dependabot/docker/*) echo docker ;;
	dependabot/docker_compose/*) echo docker-compose ;;
	*) echo unknown ;;
	esac
}

required_checks() {
	local rules
	rules=$(squad_cli_read gh-branch-rules "repos/$REPO/rules/branches/main") || return 1
	jq -e ' .
		| [.[] | select(.type == "required_status_checks") | .parameters.required_status_checks[]
			| {context, integration_id}] | unique
		| if all(.[]; (.context | type) == "string" and (.context | length) > 0) then .
		  else error("必須チェックの名前を確認できません") end' <<<"$rules"
}

list_prs() {
	local prs required numbers number pr eligible head message ecosystem files kind checks statuses ci commit current_head results='[]'
	# REST の dependabot[bot] は、gh pr view の app/dependabot と同じ作者。
	# 検索の件数上限に頼らず、開いている PR の全ページを読む。
	prs=$(squad_cli_read gh-dependabot-pulls "repos/$REPO/pulls?state=open&per_page=100" | jq ' .
		| [.[] | select(.state == "open" and .user.type == "Bot" and .user.login == "dependabot[bot]")]
		| sort_by(.number)')
	if [[ $(jq length <<<"$prs") == 0 ]]; then
		echo '[]'
		return
	fi
	required=$(required_checks)
	numbers=$(jq -r '.[].number' <<<"$prs")
	while IFS= read -r number; do
		pr=$(squad_cli_read gh-dependabot-pr "$number" "$REPO")
		# 一覧を取ったあとに閉じた PR は扱わない。
		eligible=$(jq -r '.state == "OPEN" and .author.is_bot == true and .author.login == "app/dependabot"' <<<"$pr")
		[[ $eligible == true ]] || continue
		head=$(jq -er '.headRefOid | select(test("^[a-fA-F0-9]{40}$"))' <<<"$pr")
		commit=$(squad_cli_read gh-commit "repos/$REPO/commits/$head")
		message=$(jq -er '.commit.message | select(type == "string")' <<<"$commit")
		ecosystem=$(ecosystem_of "$(jq -r .headRefName <<<"$pr")")
		files='[]'
		if [[ $ecosystem == docker || $ecosystem == docker-compose ]]; then
			files=$(squad_cli_read gh-pr-files "repos/$REPO/pulls/$number/files?per_page=100")
			# files は PR 番号の API なので、取得中に head が変わったら分類しない。
			current_head=$(read_head "$number") || return 1
			[[ $current_head == "$head" ]] || {
				echo "PR #${number} の head が変わりました。list をやり直してください。" >&2
				return 1
			}
		fi
		kind=$(update_type "$message" "$ecosystem" "$files")
		checks=$(squad_cli_read gh-check-runs "repos/$REPO/commits/$head/check-runs?filter=latest&per_page=100" | jq .check_runs)
		statuses=$(squad_cli_read gh-statuses "repos/$REPO/commits/$head/statuses?per_page=100")
		ci=$(required_ci "$required" "$checks" "$statuses")
		results=$(jq --argjson pr "$pr" --arg ecosystem "$ecosystem" --arg kind "$kind" --arg ci "$ci" '. + [{
			number: $pr.number, title: $pr.title, head_sha: $pr.headRefOid,
			update_type: $kind, ecosystem: $ecosystem, ci: $ci, mergeable: $pr.mergeable
		}]' <<<"$results")
	done <<<"$numbers"
	printf '%s\n' "$results"
}

read_commit() {
	local response
	response=$(squad_cli_read gh-commit "repos/$REPO/commits/$1") || return 1
	jq -e '{
		message: (.commit.message | select(type == "string")),
		committed_at: (.commit.committer.date | fromdateiso8601)
	}' <<<"$response"
}

read_head() {
	local response
	response=$(squad_cli_read gh-pr-head "$1" "$REPO") || return 1
	jq -er '.headRefOid' <<<"$response"
}

outcome() { printf '%s\n%s\n' "$1" "$2"; }

# PR 番号から取る差分が、指定した head のものかも確認する。
# 文脈は残し、rebase で変わる blob のハッシュと hunk の行番号だけを除く。
# 戻り値: 0 はハッシュを出力、1 は差分を取得できない、2 はバイナリを含みハッシュで比べられない、
# 3 は取得中に head が変わった。4 は head の読み取りが失敗した。
pr_diff_hash() {
	local number=$1 head=$2 diff normalized binary_lines current_head
	diff=$(gh api "repos/$REPO/pulls/$number" -H 'Accept: application/vnd.github.diff' 2>/dev/null) || return 1
	[[ $diff == 'diff --git '* ]] || return 1
	current_head=$(read_head "$number") || return 4
	[[ $current_head == "$head" ]] || return 3
	# バイナリは本文が差分に含まれず、blob の ID も消すので、内容が変わっても同じハッシュになる。
	# grep -q は最初の一致で終わり、後ろが大きいと printf が SIGPIPE で落ちて pipefail が効くため、-c で最後まで読む。
	binary_lines=$(printf '%s\n' "$diff" | grep -Ec '^(Binary files .* differ|GIT binary patch)$' || true)
	((binary_lines == 0)) || return 2
	normalized=$(printf '%s\n' "$diff" | sed -E '/^index /d; s/^@@ -[0-9]+(,[0-9]+)? \+[0-9]+(,[0-9]+)? @@/@@/') || return 1
	printf '%s\n' "$normalized" | shasum -a 256 | awk '{print $1}'
}

read_requests() {
	local number=$1 run_start=$2 viewer comments account
	account=$(squad_cli_read gh-viewer) || return 1
	viewer=$(jq -er .login <<<"$account") || return 1
	[[ -n $viewer ]] || { echo 'コメントの作者を確認できません。' >&2; return 1; }
	comments=$(squad_cli_read gh-pr-comments "repos/$REPO/issues/$number/comments?per_page=100") || return 1
	jq -c --arg viewer "$viewer" --argjson start "$run_start" '
		[.[] | select(.user.login == $viewer and (.created_at | fromdateiso8601) >= $start
			and ((.body | split("\n")[0]) == "@dependabot rebase"
				or (.body | split("\n")[0]) == "@dependabot recreate"))] | sort_by(.created_at, .id)' <<<"$comments"
}

# 呼び出しごとの引数と GitHub の時刻から復元する。
# 戻り値を呼び出し側で分岐しても、関数内の API 失敗を無視しないよう、
# この関数自体は case から直接呼ぶ。
advance() {
	local number=${1:-} reviewed='' run_deadline='' retry=false arg now deadline call_deadline run_start ci_start
	local pr head ecosystem commit message files kind required checks statuses ci mergeable merge_state
	local requests request requested_head requested_at request_count retry_used retry_request body result pause reviewed_hash diff_hash diff_status current_head
	[[ $number =~ ^[1-9][0-9]*$ ]] || usage
	shift
	while (($#)); do
		arg=$1
		case $arg in
		--reviewed-head) (($# >= 2)) && [[ -z $reviewed ]] || usage; reviewed=$2; shift 2 ;;
		--run-deadline) (($# >= 2)) && [[ -z $run_deadline ]] || usage; run_deadline=$2; shift 2 ;;
		--retry) [[ $retry == false ]] || usage; retry=true; shift ;;
		*) usage ;;
		esac
	done
	[[ $reviewed =~ ^[a-fA-F0-9]{40}$ && $run_deadline =~ ^[1-9][0-9]{0,9}$ ]] || usage
	run_start=$((run_deadline - RUN_SECONDS))
	now=$(date +%s)
	call_deadline=$((now + 300))
	while :; do
		requests=''
		pr=$(squad_cli_read gh-dependabot-pr "$number" "$REPO")
		if [[ $(jq -r '.state == "OPEN" and .author.is_bot == true and .author.login == "app/dependabot"
			and .baseRefName == "main" and .isDraft == false' <<<"$pr") != true ]]; then
			echo 'main 向けの、開いている Dependabot の通常の PR だけを進められます。' >&2
			return 1
		fi
		head=$(jq -er '.headRefOid | select(test("^[a-fA-F0-9]{40}$"))' <<<"$pr")
		# この実行で確認済み head に残したハッシュと比べられるときだけ続ける。
		if [[ $head != "$reviewed" ]]; then
			requests=$(read_requests "$number" "$run_start")
			reviewed_hash=$(jq -r --arg head "$reviewed" '[.[] | .body
				| capture("<!-- squad-dependabot-merger head: (?<head>[a-fA-F0-9]{40}) diff: (?<diff>[a-fA-F0-9]{64}) -->")
				| select(.head == $head)] | .[-1].diff // ""' <<<"$requests")
			if [[ -z $reviewed_hash ]]; then
				outcome changed '確認済みの差分のハッシュがありません。この head の PR の差分を確認し直してください。'; return
			fi
			if diff_hash=$(pr_diff_hash "$number" "$head"); then :; else
				diff_status=$?
				((diff_status != 4)) || return 1
				outcome changed '差分を取得できない、バイナリを含む、または取得中に head が変わりました。確認し直してください。'; return
			fi
			if [[ $diff_hash != "$reviewed_hash" ]]; then
				outcome changed '確認済みの PR の差分と異なります。この head の PR の差分を確認し直してください。'; return
			fi
			reviewed=$head
		fi
		ecosystem=$(ecosystem_of "$(jq -r .headRefName <<<"$pr")")
		commit=$(read_commit "$head")
		message=$(jq -r .message <<<"$commit")
		files='[]'
		if [[ $ecosystem == docker || $ecosystem == docker-compose ]]; then
			files=$(squad_cli_read gh-pr-files "repos/$REPO/pulls/$number/files?per_page=100")
			current_head=$(read_head "$number") || return 1
			if [[ $current_head != "$head" ]]; then
				outcome changed '差分の取得中に head が変わりました。確認し直してください。'; return
			fi
		fi
		kind=$(update_type "$message" "$ecosystem" "$files")
		if [[ $kind != patch && $kind != minor ]]; then
			echo '更新の種類がパッチかマイナーの PR だけを進められます。' >&2
			return 1
		fi
		mergeable=$(jq -r .mergeable <<<"$pr")
		merge_state=$(jq -r .mergeStateStatus <<<"$pr")
		required=$(required_checks)
		checks=$(squad_cli_read gh-check-runs "repos/$REPO/commits/$head/check-runs?filter=latest&per_page=100" | jq .check_runs)
		statuses=$(squad_cli_read gh-statuses "repos/$REPO/commits/$head/statuses?per_page=100")
		ci=$(required_ci "$required" "$checks" "$statuses")
		if [[ $ci == failure ]]; then outcome ci-failed '追従後の必須 CI に失敗があります。'; return; fi
		if [[ $ci == success && $mergeable == MERGEABLE && $merge_state != BEHIND && $merge_state != UNKNOWN && $merge_state != null ]]; then
			if result=$(gh pr merge "$number" --repo "$REPO" --merge --match-head-commit "$head" 2>&1); then
				outcome merged "確認した head ${head} をマージしました。"
			else
				result=$(printf '%s' "$result" | tr '\r\n' ' ')
				outcome merge-failed "マージが拒否されました: ${result}"
			fi
			return
		fi
		now=$(date +%s)
		if [[ $mergeable == CONFLICTING || $merge_state == BEHIND ]]; then
			if [[ -z $requests ]]; then requests=$(read_requests "$number" "$run_start"); fi
			if [[ $mergeable == CONFLICTING ]]; then request=recreate; else request=rebase; fi
			request_count=$(jq length <<<"$requests")
			retry_request=false
			now=$(date +%s)
			if ((request_count != 0)); then
				requested_head=$(jq -r '.[-1].body | [capture("<!-- squad-dependabot-merger head: (?<head>[a-fA-F0-9]{40})( diff: [a-fA-F0-9]{64})? -->").head][0] // ""' <<<"$requests")
				requested_at=$(jq -r '.[-1].created_at | fromdateiso8601' <<<"$requests")
				# 古い、head のない依頼も反映済みとは決めつけない。
				if [[ -z $requested_head || $requested_head == "$head" ]]; then
					if ((now < requested_at + 600)); then
						if ((now >= run_deadline)); then outcome run-timeout '実行全体の締め切りに達しました。'
						else outcome waiting 'この実行で依頼済みです。Dependabot の反映を待ちます。'; fi
						return
					fi
					# 呼び直しでも無反応への再依頼を繰り返さないよう、コメントに残す。
					retry_used=$(jq -r 'any(.[]; .body | contains("<!-- squad-dependabot-merger retry -->"))' <<<"$requests")
					if [[ $retry != true || $retry_used == true ]] || ((request_count >= 3)); then
						outcome no-response '依頼から 10 分たっても Dependabot が反応しませんでした。'; return
					fi
					retry_request=true
				elif [[ $mergeable == CONFLICTING && $(jq -r '.[-1].body | split("\n")[0]' <<<"$requests") == '@dependabot recreate' ]]; then
					outcome conflict 'Dependabot が作り直した head でもコンフリクトしています。'
					return
				fi
			fi
			if ((request_count >= 3)); then outcome behind-limit 'この実行で 3 回依頼しても main に追いつけませんでした。'; return; fi
			if ((now >= run_deadline)); then outcome run-timeout '実行全体の締め切りに達しました。'; return; fi
			# head が安定したまま比べられない差分は、ハッシュなしで依頼する。反映後は必ず確認し直す。
			if diff_hash=$(pr_diff_hash "$number" "$head"); then diff_status=0; else diff_status=$?; fi
			((diff_status != 4)) || return 1
			if ((diff_status == 3)); then
				outcome changed '取得中に head が変わりました。確認し直してください。'; return
			fi
			((diff_status == 0)) || diff_hash=''
			now=$(date +%s)
			if ((now >= run_deadline)); then outcome run-timeout '追従の依頼前に実行全体の締め切りに達しました。'; return; fi
			mkdir -p tmp
			body=$(mktemp tmp/dependabot-request.XXXXXX)
			trap "$(printf 'rm -f -- %q' "$body")" EXIT
			if [[ -n $diff_hash ]]; then
				printf '@dependabot %s\n\n<!-- squad-dependabot-merger head: %s diff: %s -->\n' "$request" "$head" "$diff_hash" >"$body"
			else
				printf '@dependabot %s\n\n<!-- squad-dependabot-merger head: %s -->\n' "$request" "$head" >"$body"
			fi
			if [[ $retry_request == true ]]; then printf '<!-- squad-dependabot-merger retry -->\n' >>"$body"; fi
			gh pr comment "$number" --repo "$REPO" --body-file "$body" >/dev/null
			rm -f "$body"
			trap - EXIT
			outcome waiting "Dependabot に ${request} を依頼しました。"
			return
		fi
		deadline=$run_deadline
		if [[ $ci == pending ]]; then
			ci_start=$(jq -r .committed_at <<<"$commit")
			((ci_start >= run_start)) || ci_start=$run_start
			if ((now >= ci_start + 1800)); then outcome ci-timeout '必須 CI が 30 分以内に確定しませんでした。'; return; fi
			((deadline <= ci_start + 1800)) || deadline=$((ci_start + 1800))
		fi
		if ((now >= run_deadline)); then outcome run-timeout '実行全体の締め切りに達しました。'; return; fi
		if ((now >= call_deadline)); then outcome waiting '必須 CI またはマージ可否の確定を待っています。'; return; fi
		pause=10
		((now + pause <= call_deadline)) || pause=$((call_deadline - now))
		((now + pause <= deadline)) || pause=$((deadline - now))
		sleep "$pause"
	done
}

# 作成後のラベル付与だけが失敗しても、次の呼び出しで同じタスクに補う。
# 既存の担当・状態は、人間が変えていることがあるので触らない。
escalation_label() {
	local id=$1 label=$2 labels
	labels=$(squad_cli_read issue-labels "$id")
	if [[ $(jq -r --arg label "$label" 'any(.[]; .id == $label)' <<<"$labels") != true ]]; then
		if multica issue label add "$id" "$label" --output json >/dev/null; then
			:
		else
			echo "タスク ${id} の運用ラベルを設定できませんでした。再実行すると同じタスクに補います。" >&2
			return 1
		fi
	fi
}

# Dependabot の PR は題・ブランチ・本文に識別子を入れられず、自動では紐付かないので API で紐付ける。
# 紐付けたら metadata の pr_url に残し、人間が外した紐付けを次の回で戻さない。
# API と待ち、トークンの扱いは共有の関数に任せる。
# 失敗してもタスクは人間に渡せるので止めず、次に同じ PR を回すときに補う。
link_pull_request() {
	local id=$1 identifier=$2 url=$3 metadata
	if metadata=$(squad_cli_read issue-metadata "$id") && jq -e 'type == "object"' <<<"$metadata" >/dev/null; then
		if pr_link_pull_request "$id" "$url" "$metadata"; then return; fi
	fi
	echo "タスク ${identifier} に PR を紐付けられませんでした。次に同じ PR を回すときに補います。急ぐときはタスクの画面で ${url} を紐付けてください。" >&2
}

escalate() {
	(($# == 4)) || usage
	local number=$1 source=$2 assignee=$4 search matches issue label member member_id member_name pr title body id identifier
	local project=$PROJECT search_limit=1000 labels members
	[[ $number =~ ^[1-9][0-9]*$ && $3 == --assignee && -n $assignee && -f $source && -r $source && -s $source ]] || usage
	search=$(squad_cli_read issue-search "$REPO#$number" --limit "$search_limit")
	matches=$(jq -ce --arg suffix "（${REPO}#${number}）" --arg project "$project" '
		if (.issues | type) != "array" then error("タスクの検索結果を確認できません")
		else [.issues[] | select(.project_id == $project and (.title | endswith($suffix)))] | sort_by(.created_at, .id) end' <<<"$search")
	# 検索は本文・コメントにも当たる。上限まで埋まったとき、存在しないとは言わない。
	if [[ $(jq length <<<"$matches") == 0 && $(jq '.issues | length' <<<"$search") -ge $search_limit ]]; then
		echo 'タスクの検索結果が上限に達しました。重複がないと確認できないため作成しません。' >&2
		return 1
	fi
	labels=$(squad_cli_read label-list)
	label=$(jq -er '[.[] | select(.name == "運用" and .resource_type == "issue")]
		| if length == 1 then .[0].id else error("運用ラベルを一意に見つけられません") end
		| select(type == "string" and length > 0)' <<<"$labels")
	if [[ $(jq length <<<"$matches") != 0 ]]; then
		id=$(jq -er '.[0].id | select(type == "string" and length > 0)' <<<"$matches")
		identifier=$(jq -er '.[0].identifier | select(type == "string" and length > 0)' <<<"$matches")
		escalation_label "$id" "$label"
		link_pull_request "$id" "$identifier" "https://github.com/${REPO}/pull/${number}"
		printf '%s exists\n' "$identifier"
		return
	fi
	# 名前のあいまいな解決でスクワッドやエージェントを担当にしない。
	members=$(squad_cli_read member-list)
	member=$(jq -ce --arg assignee "$assignee" '
		[.[] | select(.name == $assignee or .email == $assignee)]
		| if length == 1 then .[0] else error("担当のメンバーを一意に見つけられません") end' <<<"$members")
	member_id=$(jq -er '.user_id | select(type == "string" and test("^[A-Za-z0-9-]+$"))' <<<"$member")
	member_name=$(jq -er '.name | select(type == "string" and length > 0)' <<<"$member")
	pr=$(squad_cli_read gh-dependabot-pr "$number" "$REPO")
	if [[ $(jq -r '.state == "OPEN" and .author.is_bot == true and .author.login == "app/dependabot"' <<<"$pr") != true ]]; then
		echo '開いている Dependabot の PR だけを人間に回せます。' >&2
		return 1
	fi
	title=$(jq -er '.title | select(type == "string" and length > 0)' <<<"$pr")
	mkdir -p tmp
	body=$(mktemp tmp/dependabot-escalate.XXXXXX)
	trap "$(printf 'rm -f -- %q' "$body")" EXIT
	{
		printf '[@%s](mention://member/%s)\n\nPR: https://github.com/%s/pull/%s\n\n' "$member_name" "$member_id" "$REPO" "$number"
		cat "$source"
	} >"$body"
	issue=$(squad_cli_read issue-create "Dependabot の PR を確認する: ${title}（${REPO}#${number}）" "$body" \
		--project "$project" --assignee-id "$member_id" --status in_review)
	id=$(jq -er '.id | select(type == "string" and length > 0)' <<<"$issue")
	identifier=$(jq -er '.identifier | select(type == "string" and length > 0)' <<<"$issue")
	escalation_label "$id" "$label"
	rm -f "$body"
	trap - EXIT
	link_pull_request "$id" "$identifier" "https://github.com/${REPO}/pull/${number}"
	printf '%s created\n' "$identifier"
}

# 対象は呼び出し側の「このプロジェクトの値」から渡す。書き込み前に検査する。
(($# >= 3)) || usage
REPO=$1
PROJECT=$2
[[ $REPO =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ && -n $PROJECT ]] || usage
shift 2

case ${1:-} in
list)
	(($# == 1)) || usage
	list_prs
	;;
advance)
	shift
	advance "$@"
	;;
escalate)
	shift
	escalate "$@"
	;;
*) usage ;;
esac
