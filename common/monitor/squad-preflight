#!/bin/sh
# multica-squad-kit-managed
# 関所と見張りが、このスクリプトと同じディレクトリから選ばれるか確認する。
# BASH_ENV による PATH の修復を受けず、呼び出し元の PATH を確認する。
set -eu

if [ "$#" -gt 1 ]; then
	echo '使い方: squad-preflight [<タスク>]' >&2
	exit 2
fi
issue=${1-}

bin_dir=$(CDPATH= cd "$(dirname "$0")" && pwd)
set -- \
	squad-cli-lib \
	squad-dependabot-merge \
	squad-dispatch-pick \
	squad-pr-link \
	squad-pr-link-lib \
	squad-pr-watch \
	squad-review-wait \
	squad-usage-check \
	squad-usage-lib \
	squad-usage-read
status=0
for cmd in gh "$@"; do
	actual=$(command -v "$cmd") || actual='見つからない'
	if [ "$actual" = "$bin_dir/$cmd" ]; then continue; fi
	printf 'squad-preflight: %s が使えません。実際の解決先: %s（期待: %s/%s）\n' \
		"$cmd" "$actual" "$bin_dir" "$cmd" >&2
	if [ "$cmd" = gh ]; then
		echo '直し方: 動いているタスクがないときに、同じプロジェクトでセットアップを流し直してください。直らなければ、エージェントの custom_env の CLAUDE_ENV_FILE（Claude）か custom_args（Codex）を確認してください。' >&2
	else
		echo '直し方: 見張りが欠けたか、別の同じ名前のものが先にあります。動いているタスクがないときに、同じプロジェクトでセットアップを流し直して、見張りを置き直してください。' >&2
	fi
	status=1
done
[ "$status" -eq 0 ] || exit "$status"
echo 'squad-preflight: 関所の gh と、すべての見張りが使えます。'

# 解決先が全部合うまで Bash を起動しない。確認用の子も PATH を修復しない。
BASH_ENV= bash --noprofile --norc -s -- "$bin_dir" "$issue" <<'PREFLIGHT_CLI'
set -euo pipefail
source "$1/squad-cli-lib"
issue=$2
if [[ -z ${MULTICA_AGENT_ID:-} ]]; then
	echo 'squad-preflight: MULTICA_AGENT_ID がないため agent-get を確認できません。' >&2
	exit 1
fi
version=$(multica version 2>/dev/null) || version=
version=${version%%$'\n'*}
if [[ -n $version && $version != "$SQUAD_CLI_VERIFIED_VERSION" ]]; then
	printf 'squad-preflight: CLI のバージョンが見本と違います（ホスト: %s、見本: %s）。\n' \
		"$version" "$SQUAD_CLI_VERIFIED_VERSION"
fi
check_reading() {
	local name=$1 response
	shift
	response=$(squad_cli_read "$name" "$@") || return 1
	if jq -e 'type == "array" and length == 0' >/dev/null <<<"$response"; then
		printf 'squad-preflight: %s は確認できない（空）\n' "$name"
	else
		printf 'squad-preflight: %s の欄を確認しました。\n' "$name"
	fi
}
check_reading squad-list
check_reading agent-get "$MULTICA_AGENT_ID"
if [[ -n $issue ]]; then
	check_reading issue-get "$issue"
	check_reading issue-comments "$issue"
	check_reading issue-runs "$issue"
	check_reading issue-wakeups "$issue"
fi
PREFLIGHT_CLI
