#!/usr/bin/env bash
# multica-squad-kit-managed
# レビューと E2E の依頼を、変えたファイルの場所から選んだ観点で書く（macOS・Linux 用）。
#
#   squad-review-next request <タスク> <きっかけのコメント> <確認するコミット>
#     PR で変えたファイルを、ファイルの場所と観点の対応に当てて観点を選ぶ。
#     `squad-review-wait watch` を流してから、依頼のコメントをきっかけのコメントへの返信で書く。
#     コメントの ID を `依頼:` の行で、選んだ観点を `観点:` の行で出す。
#
# 観点の選び方（docs/review-next-step.md の「観点の選び方」）
#   印「重要」があるタスクは、有効な観点をすべて頼む。
#   印のないタスクは、変えたファイルごとに、プロジェクトの対応（作業先の .agents/review-paths を PR の base から読む）に
#   当たる行の役だけを使い、当たらなければ原本の既定の対応を使う。次のどれかなら、有効な観点をすべて頼む。
#     対応に当たらないファイルがある・対応を読めない・変えたファイルの一覧を読めない、または切れている・
#     選んだ観点と有効な観点の重なりが空になる。
#   有効な観点は、名簿にあるレビューと E2E の役（code-reviewer・ux-reviewer・security-reviewer・performance-reviewer・qa）。
#
# 失敗したときは、依頼を書かずに標準エラーへ要約を出して 1 で終わる。
set -euo pipefail

# GitHub の PR のファイルの一覧の上限。この件数に達したら、一覧が切れているものとして扱う。
FILES_LIMIT=3000
PATHS_FILE='.agents/review-paths'
ROLES=(code-reviewer ux-reviewer security-reviewer performance-reviewer qa)

# 原本の既定の対応。プロジェクトの対応と同じ書き方で、1 型 1 行にする。
read -r -d '' DEFAULT_PATHS <<'DEFAULTS' || true
# 文書
*.md code-reviewer
docs/ code-reviewer
# 画面
*.tsx code-reviewer,ux-reviewer,qa
*.jsx code-reviewer,ux-reviewer,qa
*.vue code-reviewer,ux-reviewer,qa
*.svelte code-reviewer,ux-reviewer,qa
*.css code-reviewer,ux-reviewer,qa
*.scss code-reviewer,ux-reviewer,qa
*.html code-reviewer,ux-reviewer,qa
# 認証と権限
**/auth/** code-reviewer,security-reviewer
**/*auth* code-reviewer,security-reviewer
**/*permission* code-reviewer,security-reviewer
# 配布と依存
.github/workflows/ code-reviewer,security-reviewer
Dockerfile code-reviewer,security-reviewer
package.json code-reviewer,security-reviewer
package-lock.json code-reviewer,security-reviewer
yarn.lock code-reviewer,security-reviewer
pnpm-lock.yaml code-reviewer,security-reviewer
go.mod code-reviewer,security-reviewer
go.sum code-reviewer,security-reviewer
Gemfile code-reviewer,security-reviewer
Gemfile.lock code-reviewer,security-reviewer
requirements*.txt code-reviewer,security-reviewer
pyproject.toml code-reviewer,security-reviewer
poetry.lock code-reviewer,security-reviewer
Cargo.toml code-reviewer,security-reviewer
Cargo.lock code-reviewer,security-reviewer
# データベース
**/migrations/** code-reviewer,performance-reviewer,security-reviewer
*.sql code-reviewer,performance-reviewer,security-reviewer
# テスト
**/test/** code-reviewer
**/tests/** code-reviewer
*_test.* code-reviewer
*.test.* code-reviewer
*.spec.* code-reviewer
# ソース
*.sh code-reviewer
*.py code-reviewer
*.go code-reviewer
*.rb code-reviewer
*.js code-reviewer
*.ts code-reviewer
*.rs code-reviewer
*.java code-reviewer
*.kt code-reviewer
*.swift code-reviewer
*.php code-reviewer
*.c code-reviewer
*.cc code-reviewer
*.cpp code-reviewer
*.h code-reviewer
DEFAULTS

# 対応と変えたファイルから、頼む観点を選ぶ。標準入力の JSON（defaults・project・files・roles・valid）を読み、
# {mode: select|all, roles, reason} を出す。対応の形の誤りは mode が all で、reason に誤りを書く。
read -r -d '' MATCH_PY <<'MATCHPY' || true
import json
import re
import sys

KNOWN = {"code-reviewer", "ux-reviewer", "security-reviewer", "performance-reviewer", "qa"}
CHARS = re.compile(r"[A-Za-z0-9_./*?@+=~-]+")


def compile_pattern(pattern):
    if not CHARS.fullmatch(pattern) or pattern.startswith("/"):
        raise ValueError("型の文字が不正")
    out = []
    i = 0
    while i < len(pattern):
        if pattern.startswith("**/", i):
            out.append("(?:.*/)?")
            i += 3
        elif pattern.startswith("**", i):
            out.append(".*")
            i += 2
        elif pattern[i] == "*":
            out.append("[^/]*")
            i += 1
        elif pattern[i] == "?":
            out.append("[^/]")
            i += 1
        else:
            out.append(re.escape(pattern[i]))
            i += 1
    body = "".join(out)
    if pattern.endswith("/"):
        body += ".+"
    # / を含まない型は、どの深さのファイル名にも当たる。
    if "/" not in pattern:
        body = "(?:.*/)?" + body
    return re.compile(body)


def parse(text):
    rules = []
    for number, raw in enumerate(text.splitlines(), 1):
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        columns = line.split()
        if len(columns) != 2:
            raise ValueError(f"{number} 行目の列の数が不正")
        names = columns[1].split(",")
        if any(name not in KNOWN for name in names):
            raise ValueError(f"{number} 行目に知らない役の名前がある")
        try:
            rules.append((compile_pattern(columns[0]), set(names)))
        except ValueError as error:
            raise ValueError(f"{number} 行目の{error}") from None
    return rules


def result(mode, roles, reason):
    print(json.dumps({"mode": mode, "roles": roles, "reason": reason}, ensure_ascii=False))


data = json.load(sys.stdin)
valid = data["valid"]
try:
    default_rules = parse(data["defaults"])
    project_rules = parse(data["project"]) if data["project"] is not None else []
except ValueError as error:
    result("all", valid, f"対応を読めないため、有効な観点をすべて頼む: プロジェクトの対応の{error}")
    sys.exit(0)

selected = set()
unmatched = project_count = default_count = 0
for item in data["files"]:
    names = [item["filename"]]
    if item.get("previous_filename"):
        names.append(item["previous_filename"])
    from_project = False
    complete = True
    for name in names:
        hits = [roles for rx, roles in project_rules if rx.fullmatch(name)]
        if hits:
            from_project = True
        else:
            hits = [roles for rx, roles in default_rules if rx.fullmatch(name)]
        if not hits:
            complete = False
        for roles in hits:
            selected |= roles
    if not complete:
        unmatched += 1
    elif from_project:
        project_count += 1
    else:
        default_count += 1

if unmatched:
    result("all", valid, f"対応に当たらないファイルが {unmatched} 件あるため、有効な観点をすべて頼む")
    sys.exit(0)
roles = [role for role in valid if role in selected]
if not roles:
    result("all", valid, "対応で選んだ観点が有効な観点にないため、有効な観点をすべて頼む")
    sys.exit(0)
total = project_count + default_count
result("select", roles, f"変えたファイル {total} 件が対応に当たった（プロジェクト {project_count} 件・既定 {default_count} 件）")
MATCHPY

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/squad-cli-lib"
script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

for cmd in jq python3 multica gh; do
	if ! command -v "$cmd" >/dev/null 2>&1; then
		echo "${cmd} が見つからない。" >&2
		exit 1
	fi
done

usage() {
	echo '使い方: squad-review-next request <タスク> <きっかけのコメント> <確認するコミット>' >&2
	exit 2
}

fail() {
	echo "依頼を書けません: $*" >&2
	exit 1
}

# タスクの metadata から、PR の URL と作業先を読む。作業先と PR のリポジトリが合わなければ失敗する。
# {url, repo, number} を出す。
pr_of() {
	jq -ce '
		.metadata as $m
		| ($m.pr_url // "") as $url
		| ($m.repository // "") as $repo
		| if ($url | test("^https://github\\.com/[A-Za-z0-9-]+/[A-Za-z0-9_.-]+/pull/[0-9]+(/.*)?$")) | not
		  then error("metadata の pr_url がない、または PR の URL の形でない")
		  elif ($repo | test("^[A-Za-z0-9-]+/[A-Za-z0-9_.-]+$")) | not
		  then error("metadata の repository がない、または形が不正")
		  else ($url | capture("^https://github\\.com/(?<repo>[^/]+/[^/]+)/pull/(?<number>[0-9]+)")) as $pr
			| if ($pr.repo | ascii_downcase) != ($repo | ascii_downcase)
			  then error("PR の URL が作業先と違う")
			  else {url: "https://github.com/\($pr.repo)/pull/\($pr.number | tonumber)", repo: $repo, number: ($pr.number | tonumber)} end
		  end' <<<"$1"
}

# プロジェクトの対応を読む。base のブランチの内容だけを読み、PR の中の書き換えでレビューを減らせないようにする。
# 読めたら内容を出して 0、base にないときは 4、読めないときは理由を標準エラーに出して 1 を返す。
read_project_paths() {
	local repo=$1 number=$2 pr base file err endpoint status=0
	pr=$(squad_cli_read gh-dependabot-pr "$number" "$repo" 2>/dev/null) || { echo 'PR の base のブランチを読めない' >&2; return 1; }
	base=$(jq -er '.baseRefName | select(type == "string" and length > 0)' <<<"$pr") || { echo 'PR の base のブランチを読めない' >&2; return 1; }
	endpoint="repos/${repo}/contents/${PATHS_FILE}?ref=$(jq -rn --arg ref "$base" '$ref | @uri')"
	err=$(mktemp tmp/review-next-read.XXXXXX) || return 1
	file=$(squad_cli_read gh-file "$endpoint" 2>"$err") || status=$?
	if ((status != 0)); then
		if grep -qF 'HTTP 404' "$err"; then
			rm -f -- "$err"
			return 4
		fi
		rm -f -- "$err"
		echo 'プロジェクトの対応を読み取れない' >&2
		return 1
	fi
	rm -f -- "$err"
	if ! jq -er 'select(.type == "file" and .encoding == "base64") | .content | gsub("\\s"; "") | @base64d' <<<"$file"; then
		echo 'プロジェクトの対応がファイルの形で読めない' >&2
		return 1
	fi
}

all_reason() {
	printf '対応を読めないため、有効な観点をすべて頼む: %s' "$1"
}

request() {
	local issue=$1 parent=$2 commit=$3 found task pr url repo number roster valid labels label_list marked files project reason mode selected status=0 id name mentions='' names='' body line out
	[[ $commit =~ ^[0-9a-fA-F]{40}$ ]] || fail '確認するコミットは、完全な SHA で渡す'
	mkdir -p tmp
	task=$(squad_cli_read issue-get "$issue") || fail 'タスクを読めない'
	pr=$(pr_of "$task") || fail 'PR を決められない（metadata の pr_url と repository を確認する）'
	url=$(jq -r .url <<<"$pr") repo=$(jq -r .repo <<<"$pr") number=$(jq -r .number <<<"$pr")
	roster=$(squad_cli_read_roster "$issue") || fail 'スクワッドの名簿を読めない'
	valid=$(jq -c --argjson order "$(printf '%s\n' "${ROLES[@]}" | jq -R . | jq -sc .)" '.roles as $r | [$order[] | select($r[.] != null)]' <<<"$roster")
	[[ $(jq length <<<"$valid") != 0 ]] || fail 'スクワッドにレビューと E2E の役がない'

	labels=$(squad_cli_read issue-labels "$issue") || fail 'タスクのラベルを読めない'
	label_list=$(squad_cli_read label-list) || fail 'ラベルの一覧を読めない'
	marked=$(jq -rn --argjson labels "$labels" --argjson all "$label_list" \
		'any($all[]; .name == "重要" and .resource_type == "issue" and (.id as $id | any($labels[]; .id == $id)))')

	mode=all selected=$valid
	if [[ $marked == true ]]; then
		reason='印「重要」があるため、有効な観点をすべて頼む'
	else
		files=$(squad_cli_read gh-pr-files "repos/${repo}/pulls/${number}/files?per_page=100" 2>/dev/null) || files=
		if [[ -z $files ]]; then
			reason=$(all_reason '変えたファイルの一覧を読めない')
		elif (($(jq length <<<"$files") >= FILES_LIMIT)); then
			reason=$(all_reason '変えたファイルの一覧が GitHub の上限で切れている')
		else
			status=0 found=1
			project=$(read_project_paths "$repo" "$number" 2>"$PWD/tmp/review-next-reason.$$") || status=$?
			((status != 4)) || { found=0 status=0; }
			if ((status != 0)); then
				reason=$(all_reason "$(<"$PWD/tmp/review-next-reason.$$")")
			else
				out=$(jq -n --arg defaults "$DEFAULT_PATHS" --arg project "$project" --argjson found "$found" --argjson files "$files" --argjson valid "$valid" \
					'{defaults: $defaults, project: (if $found == 1 then $project else null end), files: $files, valid: $valid}' | python3 -I -c "$MATCH_PY") \
					|| fail '対応の照合に失敗した'
				mode=$(jq -r .mode <<<"$out") selected=$(jq -c .roles <<<"$out") reason=$(jq -r .reason <<<"$out")
			fi
			rm -f -- "$PWD/tmp/review-next-reason.$$"
		fi
	fi

	while IFS= read -r id; do
		name=$(jq -r --arg role "$id" '.roles[$role].name' <<<"$roster")
		mentions+="${mentions:+ }[@${name}](mention://agent/$(jq -r --arg role "$id" '.roles[$role].id' <<<"$roster"))"
		names+="${names:+、}${id}"
	done < <(jq -r '.[]' <<<"$selected")
	# 見張りを先に入れる。見張りが入らなければ、依頼を書かない。
	local -a ids=()
	while IFS= read -r id; do
		ids+=("$(jq -r --arg role "$id" '.roles[$role].id' <<<"$roster")")
	done < <(jq -r '.[]' <<<"$selected")
	"$script_dir/squad-review-wait" watch "$issue" "$parent" "${ids[@]}" >/dev/null || fail '返事の待ちの見張りを入れられない（squad-review-wait watch が失敗した）'

	body=$(mktemp tmp/squad-review-request.XXXXXX) || fail '本文のファイルを作れない'
	{
		printf '確認するコミット: %s\n' "$commit"
		printf '返事を待つ役: %s\n' "$mentions"
		printf '観点: %s（%s）\n' "$names" "$reason"
		printf '対象の PR: %s\n' "$url"
	} >"$body"
	status=0
	line=$(squad_cli_read issue-comment-add "$issue" "$parent" "$body" | jq -r .id) || status=$?
	rm -f -- "$body"
	((status == 0)) || fail 'コメントの投稿に失敗した'
	printf '観点: %s（%s）\n' "$names" "$reason"
	printf '依頼: %s\n' "$line"
}

case ${1:-} in
request)
	(($# == 4)) || usage
	request "$2" "$3" "$4"
	;;
*) usage ;;
esac
