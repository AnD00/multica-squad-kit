#!/usr/bin/env bash
# multica-squad-kit-managed
# PR のコンフリクトと CI の結果を、タスクの wakeup で拾う。
# 人間に回すたびに 1 回きりの規則を入れ直し、すでにあるコンフリクトも次の確認で拾う。
#
#   squad-pr-watch link-check <タスク>
#     metadata の pr_url と紐付いた PR の一覧を比べ、紐付けの状態を 1 行で出す。書き込まない。
#     読めないときも「未確認」の行を出し、0 で終わる。
#   squad-pr-watch conflicts <タスク> [--leader <リーダーの ID>]
#     古いコンフリクトの規則を消し、呼び出した orchestrator 自身を起こす規則を作る。
#     --leader を渡すと、その ID のリーダーを起こす。役の実行（squad-review-next decide）から呼ぶときに使う。
#   squad-pr-watch conflicts-check <タスク>
#     今の head と mergeable を読み、「コンフリクト: <値> head: <SHA>」の 1 行を必ず標準出力に出す。
#     値は MERGEABLE・CONFLICTING・未確認のどれか。読めないときも「未確認」で、0 で終わる。
#   squad-pr-watch ci <タスク> <見張り役の ID> <きっかけのコメント>
#     CI が終わるたびに見張り役を起こす規則を作る。有効な規則があれば何もしない。
#   squad-pr-watch ci-check <タスク> <リーダーの ID> <見張り役の ID>
#     今の head で確定した CI の失敗があれば、ほかの役の作業中は保留し、それ以外は一度だけ知らせる。
#     0 で終わるときは、記録のスレッドに残す /note と 1 行を標準出力に出す。
#   squad-pr-watch ci-now <タスク> <リーダーの ID> <きっかけのコメント> [<見張り役の ID>]
#     同じ判定をその場で行い、メンションなしで知らせる。見張り役は省ける。
#     記録のスレッドがなければ、きっかけのコメントを metadata に書いて使う。
#   squad-pr-watch ci-held <タスク> <きっかけのコメント>
#     今の head の未処理の失敗を一度だけ出し、引き継ぎで受けた記録をきっかけへの返信に残す。
#   squad-pr-watch unlinked <タスク> <きっかけのコメント> [<見張り役の ID>] [--leader <リーダーの ID>]
#     紐付いていない PR のマージ待ちを、1 時間おき・72 時間まで確認する規則を登録する。
#     リーダーの ID は、省くと MULTICA_AGENT_ID から読む。unlinked-check に渡す ID と、見張り役がないときの起こす宛先になる。
#     見張り役を渡したときは、今のとおり見張り役を起こす。
#   squad-pr-watch unlinked-check <タスク> <リーダーの ID> [<見張り役の ID>]
#     終了・紐付けを先に確認し、CI とコンフリクト、食い違いを重複なく知らせる。
#   squad-pr-watch ci-wait <タスク> <リーダー> <きっかけのコメント> [<起きた規則>]
#     CI が成功するまで、2 時間を上限に、リーダーを起こす 1 回きりの規則で待つ。
#   squad-pr-watch ci-wait-clear <タスク>
#     待ちの規則と metadata を消す。
set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/squad-cli-lib"
PR_WATCH_SCRIPT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/squad-pr-watch"
UNLINKED_MARK='紐付いていない PR のマージ待ちの見張りで起きました。'
UNLINKED_INTERVAL=1h
UNLINKED_LIMIT_HOURS=72
UNLINKED_MAX_FIRES=100

usage() {
	echo '使い方: squad-pr-watch link-check <タスク> | conflicts <タスク> [--leader <リーダーの ID>] | conflicts-check <タスク> | ci <タスク> <見張り役の ID> <きっかけのコメント> | ci-check <タスク> <リーダーの ID> <見張り役の ID> | ci-now <タスク> <リーダーの ID> <きっかけのコメント> [<見張り役の ID>] | ci-held <タスク> <きっかけのコメント> | unlinked <タスク> <きっかけのコメント> [<見張り役の ID>] [--leader <リーダーの ID>] | unlinked-check <タスク> <リーダーの ID> [<見張り役の ID>] | ci-wait <タスク> <リーダー> <きっかけのコメント> [<起きた規則>] | ci-wait-clear <タスク>' >&2
	exit 2
}

require_commands() {
	local cmd
	for cmd in "$@"; do
		if ! command -v "$cmd" >/dev/null 2>&1; then
			echo "${cmd} が見つからない。" >&2
			exit 1
		fi
	done
}


# JSON のまま渡し、シェルの変数で失われる NUL も検証する。
pr_url_data() {
	python3 - "$@" <<'URLPY'
import json
import re
import sys
from urllib.parse import urlsplit

owner = r"[A-Za-z0-9-]+"
repo = r"[A-Za-z0-9_.-]+"
repository_pattern = re.compile(rf"{owner}/{repo}")

def canonical(value):
    if not isinstance(value, str):
        raise ValueError("GitHub の PR の URL の形でない")
    if any(ord(c) < 32 or 127 <= ord(c) <= 159 for c in value):
        raise ValueError("制御文字を含む")
    try:
        parsed = urlsplit(value)
        match = re.fullmatch(rf"/({owner})/({repo})/pull/([0-9]+)(?:/.*)?", parsed.path)
        if parsed.scheme.lower() not in ("http", "https") or parsed.netloc.lower() != "github.com" or not match:
            raise ValueError
        account, project, number = match.groups()
        number = int(number)
        if project in (".", "..") or number < 1:
            raise ValueError
    except ValueError:
        raise ValueError("GitHub の PR の URL の形でない") from None
    return f"https://github.com/{account}/{project}/pull/{number}"

metadata = json.loads(sys.argv[1])["metadata"]
value = metadata.get("pr_url")
state, url, reason = "absent", "", "metadata に pr_url がない"
line = "紐付け: pr_url なし pr: 不明"
if value is not None and value != "":
    try:
        url = canonical(value)
        source = metadata.get("repository")
        valid_source = (isinstance(source, str) and repository_pattern.fullmatch(source)
                        and source.split("/")[1] not in (".", ".."))
        if not valid_source or source.casefold() != "/".join(url.split("/")[3:5]).casefold():
            state, reason = "foreign", "PR の URL が作業先と違う"
            source = source if valid_source else ("なし" if source is None or source == "" else "不正")
            line = f"紐付け: 作業先と違う pr: {url} 作業先: {source}"
        else:
            state, reason, line = "valid", "", ""
    except ValueError as error:
        state, reason = "invalid", "PR の URL が不正"
        line = "紐付け: 不正な pr_url pr: 表示しない 理由: " + str(error)
if len(sys.argv) > 2 and state in ("valid", "absent"):
    try:
        urls = [canonical(item["html_url"]) for item in json.loads(sys.argv[2])["pull_requests"]]
        if state == "absent":
            line += " 紐付いた PR: " + ", ".join(urls) if urls else ""
        elif url.casefold() in [item.casefold() for item in urls]:
            line = "紐付け: 紐付いている pr: " + url
        elif not urls:
            line = "紐付け: 紐付いていない pr: " + url
        else:
            line = "紐付け: 食い違い pr: " + url + " 紐付いた PR: " + ", ".join(urls)
    except (ValueError, KeyError, TypeError):
        line = "紐付け: 未確認 pr: " + (url or "不明") + " 理由: PR の URL を判定できない"
print(json.dumps(dict(state=state, url=url, reason=reason, line=line), ensure_ascii=False))
URLPY
}

link_check() {
	local issue=$1 cmd task data pr_url prs
	for cmd in jq python3 multica; do
		if ! command -v "$cmd" >/dev/null 2>&1; then
			printf '紐付け: 未確認 pr: 不明 理由: %s が見つからない\n' "$cmd"
			return 0
		fi
	done
	if ! task=$(squad_cli_read issue-get "$issue") || ! data=$(pr_url_data "$task"); then
		echo '紐付け: 未確認 pr: 不明 理由: タスクを読めない（CLI の失敗か欄の不正）'
		return 0
	fi
	case $(jq -r .state <<<"$data") in
	foreign | invalid) jq -r .line <<<"$data"; return 0 ;;
	esac
	pr_url=$(jq -r '.url | if . == "" then "不明" else . end' <<<"$data")
	if ! prs=$(squad_cli_read issue-pull-requests "$issue"); then
		printf '紐付け: 未確認 pr: %s 理由: 紐付いた PR の一覧を読めない（CLI の失敗か欄の不正）\n' "$pr_url"
		return 0
	fi
	pr_url_data "$task" "$prs" | jq -r .line
}

conflicts() {
	local issue=$1 leader=${2-} rules ids id instruction response
	local -a target=()
	[[ -z $leader ]] || target=(--agent-id "$leader")
	# CI など、ほかの条件の規則は残す。無効になった古い規則も消してから入れ直す。
	rules=$(squad_cli_read issue-wakeups "$issue")
	ids=$(jq -r '.[] | select(.condition.type == "pull_request" and .condition.event == "conflicts") | .id' <<<"$rules")
	while IFS= read -r id; do
		[[ -n $id ]] || continue
		multica issue wakeup delete "$issue" "$id" --output json >/dev/null
	done <<<"$ids"

	# 作業ディレクトリの tmp/ に置く。Multica は登録時に本文を読み込むので、登録後は消せる。
	mkdir -p tmp
	instruction=$(mktemp tmp/pr-watch-conflicts.XXXXXX)
	# EXIT の時点では関数の local が消えていることがあるので、パスはここで埋め込む。
	trap "$(printf 'rm -f -- %q' "$instruction")" EXIT
	cat >"$instruction" <<'EOF'
PR のコンフリクトの見張りで起きました。
タスクの状態とコメントを読み、in_review で、最後に人間を呼んだのがマージを待つためかを確認してください。
マージ待ちで、レビューと E2E の返事を待つ回の途中でなければ、リーダーの「実装・修正の振り分け」に従い、有効な修正の役を選んでください。選んだ役にタスクの metadata の pr_url を書いて、main とのコンフリクトの解消を頼み、タスクを in_progress にしてください。
そうでなければ、何もせずに終えてください。作業中のコンフリクトは、次にマージに回すときに入れ直す見張りが拾います。
EOF
	# --agent-id を省くと、呼び出した orchestrator 自身を起こす。--leader を渡したときは、その ID を起こす。既定の mode は once。
	response=$(squad_cli_read issue-wakeup-create "$issue" "$instruction" --until-pr conflicts ${target[@]+"${target[@]}"})
	jq '{id}' <<<"$response"
	rm -f "$instruction"
	trap - EXIT
}

# 結果は、どの場合も標準出力の 1 行にする。値は MERGEABLE・CONFLICTING・未確認のどれか。
# 「なし」の語は使わない。読み違えを防ぐため、失敗でも終了コード 0 で終える。
conflicts_check_line() {
	local value=$1 head=$2 reason=${3:-}
	printf 'コンフリクト: %s head: %s' "$value" "$head"
	if [[ -n $reason ]]; then
		printf ' 理由: %s' "$reason"
	fi
	printf '\n'
}

conflicts_check() {
	local issue=$1 cmd task pr_url pr head new state mergeable start now remain wait data
	# 間隔を空けた確認では通信・欄の検証の失敗を非0で返す。既存の呼び方は0のままにする。
	local strict=${2:-0}
	# mergeable は push の直後に UNKNOWN になりやすい。10 秒おきに、最初の読み取りから 60 秒まで読み直す。
	local interval=10 limit=60
	head=不明
	for cmd in jq python3 multica gh; do
		if ! command -v "$cmd" >/dev/null 2>&1; then
			conflicts_check_line 未確認 不明 "${cmd} が見つからない"
			return "$strict"
		fi
	done
	if ! task=$(multica issue get "$issue" --output json) || ! pr_url=$(jq -r '.metadata.pr_url // empty' <<<"$task"); then
		conflicts_check_line 未確認 不明 'タスクを読めない'
		return "$strict"
	fi
	if [[ -z $pr_url ]]; then
		conflicts_check_line 未確認 不明 'metadata に pr_url がない'
		return "$strict"
	fi
	data=$(pr_url_data "$task")
	if [[ $(jq -r .state <<<"$data") != valid ]]; then
		conflicts_check_line 未確認 不明 "$(jq -r .reason <<<"$data")"
		return "$strict"
	fi
	pr_url=$(jq -r .url <<<"$data")
	start=$(date +%s)
	while :; do
		# 共通の応答契約で読む。state・headRefOid・mergeable のどれかが欠けた応答は、「未確認」にする。
		if ! pr=$(squad_cli_read gh-pr-mergeable "$pr_url") \
			|| ! new=$(jq -r '.headRefOid' <<<"$pr") || [[ -z $new ]]; then
			conflicts_check_line 未確認 "$head" 'PR を読めない（gh の失敗か必須欄の欠落）'
			return "$strict"
		fi
		head=$new
		state=$(jq -r '.state' <<<"$pr")
		case $state in
		MERGED | CLOSED)
			conflicts_check_line 未確認 "$head" 'PR がマージ済みか閉じている'
			return 0
			;;
		esac
		mergeable=$(jq -r '.mergeable' <<<"$pr")
		case $mergeable in
		MERGEABLE | CONFLICTING)
			conflicts_check_line "$mergeable" "$head"
			return 0
			;;
		UNKNOWN) ;;
		*)
			conflicts_check_line 未確認 "$head" "mergeable が想定外の値 ${mergeable:-空}"
			return 0
			;;
		esac
		# 新しい読み取りは、60 秒までしか始めない。待ちは、残り時間を超えない。
		now=$(date +%s)
		remain=$((limit - (now - start)))
		if ((remain <= 0)); then
			break
		fi
		wait=$interval
		if ((remain < wait)); then
			wait=$remain
		fi
		sleep "$wait"
	done
	conflicts_check_line 未確認 "$head" "mergeable が ${limit} 秒たっても UNKNOWN"
}

ci() {
	local issue=$1 monitor=$2 trigger=$3 id rules paused old old_id instruction task thread status response
	id=$monitor
	rules=$(squad_cli_read issue-wakeups "$issue" | jq --arg id "$id" '
		[.[] | select(.agent_id == $id and .mode == "continuous"
			and .condition.type == "pull_request" and .condition.event == "checks_finished")]')
	# 暴走の防止で止まった規則は、作り直して解除しない。
	paused=$(jq -r '[.[] | select(.paused_reason == "loop" or .paused_reason == "rate") | .paused_reason] | unique | join(", ")' <<<"$rules")
	if [[ -n $paused ]]; then
		echo "CI の見張りが止まっています（${paused}）。次に人間を呼ぶコメントに添えてください。"
		return 0
	fi
	if jq -e 'any(.[]; .enabled == true)' <<<"$rules" >/dev/null; then
		return 0
	fi
	# 規則を消して入れ直しても、タスクごとの同じ記録のスレッドに続ける。
	task=$(squad_cli_read issue-get "$issue")
	thread=$(jq -r '.metadata.ci_watch_thread | select(. != null)' <<<"$task")
	if [[ -n $thread ]]; then
		if multica issue comment list "$issue" --thread "$thread" --tail 0 --compact --output json >/dev/null; then
			:
		else
			status=$?
			# CLI の終了コード 4 は 404。それ以外は記録先も規則も変えず、エラーを返す。
			((status == 4)) || return "$status"
			thread=
		fi
	fi
	if [[ -z $thread ]]; then
		# コメントで起きた実行は、きっかけへの返信しか書けない。根のコメントは作らない。
		thread=$trigger
		multica issue metadata set "$issue" --key ci_watch_thread --value "$thread" --output json >/dev/null
	fi
	# max_fires に達した規則など、有効でなくなった古い規則は入れ直す。
	old=$(jq -r '.[].id' <<<"$rules")
	while IFS= read -r old_id; do
		[[ -n $old_id ]] || continue
		multica issue wakeup delete "$issue" "$old_id" --output json >/dev/null
	done <<<"$old"
	mkdir -p tmp
	instruction=$(mktemp tmp/pr-watch-ci.XXXXXX)
	trap "$(printf 'rm -f -- %q' "$instruction")" EXIT
	cat >"$instruction" <<'EOF'
PR の CI が終わりました。あなたの指示に従い、「このプロジェクトの値」からリーダーと見張り役の ID を渡して squad-pr-watch ci-check で今の head の CI を確認してください。
判定と失敗の知らせはスクリプトが行います。スクリプトが 0 で終わったら、標準出力をそのまま最後の返答にしてください。
EOF
	printf '記録のスレッド: %s（0 以外で終わったときの返信先）\n' "$thread" >>"$instruction"
	response=$(squad_cli_read issue-wakeup-create "$issue" "$instruction" --until-pr checks --mode continuous --agent-id "$id" \
		--max-fires 200 --parent "$thread")
	jq '{id}' <<<"$response"
	rm -f "$instruction"
	trap - EXIT
}

ci_record() {
	printf '/note\n%s\n' "$1"
}

# ci-check と ci-held は同じ結論を失敗として扱う。
ci_failures() {
	jq '[.[]
		| select((.__typename == "CheckRun" and .status == "COMPLETED" and (.conclusion == "FAILURE" or .conclusion == "TIMED_OUT" or .conclusion == "STARTUP_FAILURE"))
			or (.__typename == "StatusContext" and (.state == "FAILURE" or .state == "ERROR")))
		| if .__typename == "CheckRun" then
			(if .workflowName != "" then .workflowName + " / " else "" end) + .name
		  else .context end] | unique' <<<"$1"
}

ci_handled() {
	jq -e --arg prefix "head: ${2}"$'\nCI の失敗を検出しました。' \
		--arg received "/note"$'\n'"CI ${2}: 保留した失敗を" '
		any(.[]; .author_type == "agent" and
			((.content | startswith($prefix)) or
			 (.content | rtrimstr("\n") | startswith($received) and endswith("が引き継ぎで受けた"))))
	' <<<"$1" >/dev/null
}

ci_check() {
	local issue=$1 id=$2 monitor_id=$3 orchestrator task thread pr_url pr checks failures head short comments body runs active names role name agent squad handoffs notice target selection_status
	local mode=${4:-watch} trigger=${5-} data
	task=$(squad_cli_read issue-get "$issue")
	data=$(pr_url_data "$task")
	if [[ $(jq -r .state <<<"$data") != valid ]]; then
		if [[ $mode == now ]]; then jq -r .line <<<"$data"; return 0; fi
		jq -r .reason <<<"$data" >&2
		return 1
	fi
	pr_url=$(jq -r .url <<<"$data")
	thread=$(jq -r '.metadata.ci_watch_thread | select(. != null)' <<<"$task")
	if [[ -z $thread ]]; then
		if [[ $mode == now ]]; then
			thread=$trigger
			multica issue metadata set "$issue" --key ci_watch_thread --value "$thread" --output json >/dev/null
		else
			echo 'metadata に ci_watch_thread がありません。CI の見張りを登録し直してください。' >&2
			return 1
		fi
	fi
	# その場の通知は今回のきっかけへ返信し、既存の見張りの記録先は保つ。
	if [[ $mode == now ]]; then thread=$trigger; fi
	case $(jq -r '.status_category' <<<"$task") in
	done | cancelled)
		ci_record 'CI: タスクが終わっているので見ない'
		return 0
		;;
	esac
	pr=$(squad_cli_read gh-pr-checks "$pr_url")
	head=$(jq -er '.headRefOid | select(length > 0)' <<<"$pr")
	short=${head:0:7}
	case $(jq -r .state <<<"$pr") in
	MERGED | CLOSED)
		ci_record "CI ${short}: PR がマージ済みか閉じているので見ない"
		return 0
		;;
	esac
	checks=$(jq '.statusCheckRollup' <<<"$pr")
	if [[ $(jq length <<<"$checks") == 0 ]]; then
		ci_record "CI ${short}: チェックなし"
		return 0
	fi
	# 失敗が確定した時点で wakeup は発火する。同じ head の失敗では発火し直さないため、
	# ほかのチェックの終了は待たない。CANCELLED は失敗に数えない。
	failures=$(ci_failures "$checks")
	if [[ $(jq length <<<"$failures") == 0 ]]; then
		if jq -e 'any(.[];
			if .__typename == "CheckRun" then .status != "COMPLETED"
			elif .__typename == "StatusContext" then (.state != "SUCCESS" and .state != "FAILURE" and .state != "ERROR")
			else true end)' <<<"$checks" >/dev/null; then
			ci_record "CI ${short}: 失敗なし（実行中のチェックあり）"
		else
			ci_record "CI ${short}: 失敗なし"
		fi
		return 0
	fi
	# 取得記録は起点への返信なので、別のスレッドや解決済みの記録も含めて重複を防ぐ。
	# source_task_id で、run が終わる前に投稿された引き継ぎを対応付ける。
	comments=$(squad_cli_read issue-comments "$issue")
	if ci_handled "$comments" "$short"; then
		ci_record "CI ${short}: 失敗は知らせ済み"
		return 0
	fi
	if [[ $mode == watch ]]; then
		agent=$(squad_cli_read agent-get "$id")
		orchestrator=$(jq -r '.name' <<<"$agent")
	fi
	runs=$(squad_cli_read issue-runs "$issue")
	# 引き継ぎ後も run は短時間 running のまま残る。引き継ぎ済みの run では
	# 保留しない。取得の確認より後に確定した失敗も、通常の通知で拾えるようにする。
	# 引き継ぎは、担当のスクワッドへのメンション（今の形式）か、リーダーへのエージェントのメンション。
	squad=$(jq -r 'select(.assignee_type == "squad") | .assignee_id | select(. != null)' <<<"$task")
	handoffs=$(jq -cn --arg agent "mention://agent/${id})" --arg squad "$squad" \
		'[$agent] + if $squad != "" then ["mention://squad/" + $squad + ")"] else [] end')
	active=$(jq -r --arg id "$id" --arg monitor "$monitor_id" --argjson comments "$comments" \
		--argjson handoffs "$handoffs" --arg report $'/note\n確認したコミット:' '[.[] | . as $run
		| select(.agent_id != null and .agent_id != $id and .agent_id != $monitor
			and .status != "completed" and .status != "failed" and .status != "cancelled")
		| select(any($comments[]; $run.id != null and .source_task_id == $run.id
			and .author_type == "agent" and .author_id == $run.agent_id
			and (.content | . as $content | startswith($report) or any($handoffs[]; . as $handoff | $content | contains($handoff)))) | not)
		| .agent_id] | unique | .[]' <<<"$runs")
	if [[ -n $active ]]; then
		names=''
		while IFS= read -r role; do
			agent=$(squad_cli_read agent-get "$role")
			name=$(jq -r '.name' <<<"$agent")
			names+="${names:+、}${name}"
		done <<<"$active"
		ci_record "CI ${short}: 失敗あり（${names} の作業中なので保留）"
		return 0
	fi
	notice=''
	if [[ $mode == watch ]]; then
		# 欄の検証と通信の失敗は通知にすり替えない。候補が 0 件・複数のときだけ従来の通知先へ戻す。
		if target=$(squad_cli_squad_for_leader "$id"); then
			notice=$(jq -r '"[@" + .name + "](mention://squad/" + .id + ")"' <<<"$target")
		else
			selection_status=$?
			((selection_status == 2)) || return "$selection_status"
			notice="[@${orchestrator}](mention://agent/${id})"
		fi
	fi
	mkdir -p tmp
	body=$(mktemp tmp/pr-watch-ci-result.XXXXXX)
	trap "$(printf 'rm -f -- %q' "$body")" EXIT
	{
		printf 'head: %s\nCI の失敗を検出しました。\n' "$short"
		if [[ -n $notice ]]; then printf '\n%s\n' "$notice"; fi
		printf '\nPR: %s\n\n失敗したチェック:\n' "$pr_url"
		jq -r '.[] | "- " + .' <<<"$failures"
	} >"$body"
	# Actions の URL は書かず、PR とチェックの名前で知らせる。
	multica issue comment add "$issue" --parent "$thread" --content-file "$body" --output table >/dev/null
	rm -f "$body"
	trap - EXIT
	if [[ $mode == now ]]; then
		ci_record "CI ${short}: 失敗あり"
	else
		ci_record "CI ${short}: 失敗をリーダーに知らせた"
	fi
}

ci_held() {
	local issue=$1 trigger=$2 task thread pr_url pr head short failures comments received body data
	task=$(squad_cli_read issue-get "$issue")
	case $(jq -r '.status_category' <<<"$task") in
	done | cancelled) return 0 ;;
	esac
	thread=$(jq -r '.metadata.ci_watch_thread | select(. != null)' <<<"$task")
	[[ -n $thread ]] || return 0
	data=$(pr_url_data "$task")
	if [[ $(jq -r .state <<<"$data") != valid ]]; then
		jq -r .reason <<<"$data" >&2
		return 1
	fi
	pr_url=$(jq -r .url <<<"$data")
	pr=$(squad_cli_read gh-pr-checks "$pr_url")
	case $(jq -r .state <<<"$pr") in
	MERGED | CLOSED) return 0 ;;
	esac
	head=$(jq -er '.headRefOid | select(length > 0)' <<<"$pr")
	short=${head:0:7}
	failures=$(ci_failures "$(jq '.statusCheckRollup' <<<"$pr")")
	[[ $(jq length <<<"$failures") != 0 ]] || return 0
	comments=$(squad_cli_read issue-comments "$issue")
	if ci_handled "$comments" "$short"; then
		return 0
	fi
	# 見張り役の保留コメントより先に引き継ぎが届くことがある。
	# 保留の投稿を待たず、GitHub で確定した今の head の失敗を拾う。
	received="CI ${short}: 保留した失敗をリーダーが引き継ぎで受けた"
	mkdir -p tmp
	body=$(mktemp tmp/pr-watch-ci-held.XXXXXX)
	trap "$(printf 'rm -f -- %q' "$body")" EXIT
	ci_record "$received" >"$body"
	multica issue comment add "$issue" --parent "$trigger" --content-file "$body" --output table >/dev/null
	rm -f "$body"
	trap - EXIT
	jq -r '.[]' <<<"$failures"
}

unlinked_clear() {
	local issue=$1 rules ids id
	rules=$(squad_cli_read issue-wakeups "$issue") || return 1
	ids=$(jq -r --arg mark "$UNLINKED_MARK" '.[] | select((.instruction | split("\n")[0]) == $mark) | .id' <<<"$rules") || return 1
	while IFS= read -r id; do
		[[ -n $id ]] || continue
		multica issue wakeup delete "$issue" "$id" --output json >/dev/null || return "$?"
	done <<<"$ids"
}


# 同時登録でも、作成日時と ID の同じ順で 1 つを残す。
unlinked_deduplicate() {
	local issue=$1 rules ordered ids id status survivor thread task current
	while :; do
		rules=$(squad_cli_read issue-wakeups "$issue") || return 1
		ordered=$(jq --arg mark "$UNLINKED_MARK" '[.[] | select((.instruction | split("\n")[0]) == $mark)]
			| sort_by(.created_at, .id)' <<<"$rules") || return 1
		survivor=$(jq -r '.[0].id // empty' <<<"$ordered")
		[[ -n $survivor ]] || return 0
		thread=$(jq -er '.[0].parent_comment_id | select(type == "string" and length > 0)' <<<"$ordered") || return 1
		ids=$(jq -r '.[1:][] | .id' <<<"$ordered")
		while IFS= read -r id; do
			[[ -n $id ]] || continue
			if multica issue wakeup delete "$issue" "$id" --output json >/dev/null; then :; else
				status=$?
				# 同時に同じ余分な規則を消した場合の 404 だけは、整理済みとする。
				((status == 4)) || return "$status"
			fi
		done <<<"$ids"
		# 初期化の最後の書き込みではなく、残す規則の返信先に記録をそろえる。
		task=$(squad_cli_read issue-get "$issue") || return 1
		if [[ $(jq -r '.metadata.ci_watch_thread | select(. != null)' <<<"$task") != "$thread" ]]; then
			multica issue metadata set "$issue" --key ci_watch_thread --value "$thread" --output json >/dev/null || return "$?"
		fi
		# 別の登録が規則を入れ直した場合、消された規則の記録先を残さない。
		rules=$(squad_cli_read issue-wakeups "$issue") || return 1
		current=$(jq -r --arg mark "$UNLINKED_MARK" '[.[] | select((.instruction | split("\n")[0]) == $mark)]
			| sort_by(.created_at, .id) | .[0].id // empty' <<<"$rules") || return 1
		[[ $current != "$survivor" ]] || return 0
	done
}

unlinked() {
	local issue=$1 trigger=$2 monitor=${3-} leader=${4-} target task thread instruction response expires data
	[[ -n $leader ]] || leader=${MULTICA_AGENT_ID:-}
	if [[ -z $leader ]]; then
		echo 'MULTICA_AGENT_ID がなく、--leader もありません。呼び出したリーダーを決められません。' >&2
		return 1
	fi
	task=$(squad_cli_read issue-get "$issue")
	data=$(pr_url_data "$task")
	if [[ $(jq -r .state <<<"$data") != valid ]]; then jq -r .line <<<"$data"; return 0; fi
	unlinked_clear "$issue"
	thread=$(jq -r '.metadata.ci_watch_thread | select(. != null)' <<<"$task")
	if [[ -z $thread ]]; then
		thread=$trigger
	fi
	target=${monitor:-$leader}
	mkdir -p tmp
	instruction=$(mktemp tmp/pr-watch-unlinked.XXXXXX)
	trap "$(printf 'rm -f -- %q' "$instruction")" EXIT
	{
		printf '%s\n' "$UNLINKED_MARK"
		printf '次のコマンドで確認してください。0 以外で終わったときも、取得できた行を下の指示のとおり扱ってから、記録のスレッドへ失敗を書いてください。\n'
		printf 'squad-pr-watch unlinked-check %q %q' "$issue" "$leader"
		if [[ -n $monitor ]]; then printf ' %q' "$monitor"; fi
		printf '\n'
		if [[ -n $monitor ]]; then
			printf '0 で終わったら、標準出力をそのまま最後の返答にしてください。\n'
		else
			cat <<'EOF'
紐付け: 食い違い の行があれば、両方の PR を示して人間を呼び、どちらが正かを決めるまでマージしないよう頼んでください。タスクは in_review のままにしてください。
紐付け: 作業先と違う、紐付け: 不正な pr_url の行があれば、その行だけを添えて人間を呼び、タスクの画面で metadata の pr_url か repository を直してもらってください。元の値は写さず、修正するまでマージしないよう頼み、タスクは in_review のままにしてください。
CI <SHA>: 失敗あり で始まり、保留でなければ、リーダーの「CI の失敗で起きたとき」と同じに扱ってください。
コンフリクト: CONFLICTING で、知らせ: 書いた なら、リーダーの「起きたときの確認」に進んでください。
それ以外は、行を /note の記録にして終えてください。
EOF
		fi
		printf '記録のスレッド: %s（0 以外で終わったときの返信先）\n' "$thread"
	} >"$instruction"
	# 表示は登録直前からの期限を分単位で出す。実際の終了はサーバーの expires-in が決める。
	expires=$(python3 - "$UNLINKED_LIMIT_HOURS" <<'PY'
from datetime import datetime, timedelta, timezone
import sys
print((datetime.now(timezone.utc) + timedelta(hours=int(sys.argv[1]))).strftime("%Y-%m-%dT%H:%MZ"))
PY
	)
	response=$(squad_cli_read issue-wakeup-create "$issue" "$instruction" --kind every --every "$UNLINKED_INTERVAL" \
		--expires-in "${UNLINKED_LIMIT_HOURS}h" --on-timeout end --max-fires "$UNLINKED_MAX_FIRES" --agent-id "$target" --parent "$thread")
	unlinked_deduplicate "$issue"
	jq '{id}' <<<"$response"
	printf '見張り: 1 時間おき、%s まで\n' "$expires"
	rm -f "$instruction"
	trap - EXIT
}

# 見張り役がない場合は、自分をもう一度起こさない。通知先の選び方は ci-check とそろえる。
unlinked_notice() {
	local leader=$1 monitor=$2 target status agent name
	[[ -n $monitor ]] || return 0
	if target=$(squad_cli_squad_for_leader "$leader"); then
		jq -r '"[@" + .name + "](mention://squad/" + .id + ")"' <<<"$target"
	else
		status=$?
		((status == 2)) || return "$status"
		agent=$(squad_cli_read agent-get "$leader") || return 1
		name=$(jq -r '.name' <<<"$agent") || return 1
		printf '[@%s](mention://agent/%s)\n' "$name" "$leader"
	fi
}

unlinked_post() {
	local issue=$1 thread=$2 content=$3 body
	mkdir -p tmp
	body=$(mktemp tmp/pr-watch-unlinked-result.XXXXXX)
	trap "$(printf 'rm -f -- %q' "$body")" EXIT
	printf '%s\n' "$content" >"$body"
	multica issue comment add "$issue" --parent "$thread" --content-file "$body" --output table >/dev/null
	rm -f "$body"
	trap - EXIT
}

unlinked_seen() {
	jq -e --arg prefix "$2" 'any(.[]; .author_type == "agent" and (.content | startswith($prefix)))' <<<"$1" >/dev/null
}

unlinked_stop() {
	unlinked_clear "$1"
	ci_record "止めた: $2"
}

# 判定の行を安全な形で知らせ、同じ知らせを重ねずに自分の規則を消す。
unlinked_link_stop() {
	local issue=$1 leader=$2 monitor=$3 task=$4 link_line=$5 title=$6 thread comments prefix notice content
	thread=$(jq -r '.metadata.ci_watch_thread | select(. != null)' <<<"$task")
	if [[ -z $thread ]]; then
		echo 'metadata に ci_watch_thread がありません。マージ待ちの見張りを登録し直してください。' >&2
		return 1
	fi
	comments=$(squad_cli_read issue-comments "$issue")
	prefix="$title"$'\n'"$link_line"$'\n'
	if ! unlinked_seen "$comments" "$prefix"; then
		notice=$(unlinked_notice "$leader" "$monitor")
		content=$(printf '%s' "$prefix"; if [[ -n $notice ]]; then printf '\n%s\n' "$notice"; fi)
		unlinked_post "$issue" "$thread" "$content"
	fi
	unlinked_clear "$issue"
	ci_record "$link_line"
}

unlinked_check() {
	local issue=$1 leader=$2 monitor=${3-} task pr_url pr thread link_line comments prefix notice content conflict_line head short result data
	local status=0 ci_line
	task=$(squad_cli_read issue-get "$issue")
	case $(jq -r '.status_category' <<<"$task") in
	done | cancelled) unlinked_stop "$issue" 'タスクが終わっている'; return 0 ;;
	esac
	data=$(pr_url_data "$task")
	case $(jq -r .state <<<"$data") in
	foreign | invalid)
		unlinked_link_stop "$issue" "$leader" "$monitor" "$task" "$(jq -r .line <<<"$data")" 'PR の URL を確認できませんでした。'
		return 0 ;;
	absent) echo 'metadata に pr_url がない' >&2; return 1 ;;
	esac
	pr_url=$(jq -r .url <<<"$data")
	if pr=$(squad_cli_read gh-pr-mergeable "$pr_url"); then
		case $(jq -r '.state' <<<"$pr") in
		MERGED | CLOSED) unlinked_stop "$issue" 'PR がマージ済みか閉じている'; return 0 ;;
		esac
	else
		status=$?
	fi
	if [[ $(jq -r '.status' <<<"$task") != in_review ]]; then
		unlinked_stop "$issue" 'マージ待ちから外れている'
		return 0
	fi
	link_line=$(link_check "$issue")
	case $link_line in
	'紐付け: 紐付いている '*) unlinked_stop "$issue" 'PR がタスクに紐付いた'; return 0 ;;
	'紐付け: 食い違い '*)
		unlinked_link_stop "$issue" "$leader" "$monitor" "$task" "$link_line" '紐付けの食い違いを検出しました。'
		return 0 ;;
	'紐付け: 作業先と違う '* | '紐付け: 不正な pr_url '*)
		unlinked_link_stop "$issue" "$leader" "$monitor" "$task" "$link_line" 'PR の URL を確認できませんでした。'
		return 0 ;;
	esac
	thread=$(jq -r '.metadata.ci_watch_thread | select(. != null)' <<<"$task")
	if [[ -z $thread ]]; then
		echo 'metadata に ci_watch_thread がありません。マージ待ちの見張りを登録し直してください。' >&2
		return 1
	fi
	printf '/note\n'
	if [[ $link_line == '紐付け: 未確認 '* ]]; then printf '%s\n' "$link_line"; fi
	# 別プロセスで実行し、失敗を捕まえる条件式が ci_check の errexit を無効にしないようにする。
	if [[ -n $monitor ]]; then
		if ci_line=$(bash "$PR_WATCH_SCRIPT" ci-check "$issue" "$leader" "$monitor"); then :; else status=$?; fi
	else
		if ci_line=$(bash "$PR_WATCH_SCRIPT" ci-now "$issue" "$leader" "$thread"); then :; else status=$?; fi
	fi
	if [[ -n $ci_line ]]; then printf '%s\n' "$ci_line" | sed '1{/^\/note$/d;}'; fi
	if conflict_line=$(conflicts_check "$issue" 1); then
		result=なし
		if [[ $conflict_line == 'コンフリクト: CONFLICTING head: '* ]]; then
			head=${conflict_line#* head: }
			head=${head%% *}
			short=${head:0:7}
			prefix="head: ${short}"$'\nコンフリクトを検出しました。\n'
			comments=$(squad_cli_read issue-comments "$issue")
			if unlinked_seen "$comments" "$prefix"; then
				result=知らせ済み
			else
				notice=$(unlinked_notice "$leader" "$monitor")
				content=$(printf '%s' "$prefix"; if [[ -n $notice ]]; then printf '\n%s\n' "$notice"; fi
					printf '\nPR: %s\n%s\n' "$pr_url" "$conflict_line")
				unlinked_post "$issue" "$thread" "$content"
				result=書いた
			fi
		fi
		printf '%s 知らせ: %s\n' "$conflict_line" "$result"
	else
		status=$?
	fi
	return "$status"
}

# 継続的な CI 見張りやコンフリクトの規則は残し、待ち専用の規則だけを消す。
ci_wait_delete_rules() {
	local issue=$1 task=$2 rules ids id
	rules=$(squad_cli_read issue-wakeups "$issue") || return 1
	ids=$(jq -r --arg old "$(jq -r '.metadata.ci_wait_rule | select(. != null)' <<<"$task")" '
		.[] | select(.id == $old or (.mode == "once"
			and .condition.type == "pull_request" and .condition.event == "checks_finished"
			and (.instruction | startswith("CI の待ちの規則で起きました。")))) | .id' <<<"$rules")
	while IFS= read -r id; do
		[[ -n $id ]] || continue
		multica issue wakeup delete "$issue" "$id" --output json >/dev/null || return 1
	done <<<"$ids"
}

ci_wait_clear() {
	local issue=$1 task=${2:-} key
	[[ -n $task ]] || task=$(squad_cli_read issue-get "$issue") || return 1
	ci_wait_delete_rules "$issue" "$task" || return 1
	for key in ci_wait_rule ci_wait_head ci_wait_since; do
		if jq -e --arg key "$key" '.metadata | has($key)' <<<"$task" >/dev/null; then
			multica issue metadata delete "$issue" --key "$key" --output json >/dev/null || return 1
		fi
	done
}

ci_wait_line() {
	local head=$1 state=$2
	printf 'CI%s: %s\n' "${head:+ $head}" "$state"
}

ci_wait_finish() {
	local issue=$1 task=$2 trigger=$3 comments=$4 head=$5 state=$6 failures=$7 body
	if [[ $state == 失敗あり ]] && ! ci_handled "$comments" "${head:0:7}"; then
		mkdir -p tmp
		body=$(mktemp tmp/pr-watch-ci-wait-held.XXXXXX)
		trap "$(printf 'rm -f -- %q' "$body")" EXIT
		ci_record "CI ${head:0:7}: 保留した失敗をリーダーが引き継ぎで受けた" >"$body"
		multica issue comment add "$issue" --parent "$trigger" --content-file "$body" --output table >/dev/null || return 1
		rm -f "$body"
		trap - EXIT
	fi
	ci_wait_clear "$issue" "$task" || return 1
	ci_wait_line "$head" "$state"
	if [[ $state == 失敗あり ]]; then jq -r '.[]' <<<"$failures"; fi
}

ci_wait() {
	local issue=$1 leader=$2 trigger=$3 fired=${4:-} task head since now pass pr_url pr new_head checks failures state comments
	local instruction response rule remaining key data
	local limit=7200 interval=1800
	task=$(squad_cli_read issue-get "$issue") || return 1
	# 削除の直前に起動が決まっていた規則も、今の規則と違えば何もせず終える。
	if [[ -n $fired ]] && ! jq -e --arg fired "$fired" '
		.metadata | has("ci_wait_head") and .ci_wait_since != null and .ci_wait_rule == $fired' <<<"$task" >/dev/null; then
		echo 'CI 待ち: 終わった規則で起きた'
		return 0
	fi
	if ! jq -e '.metadata |
		(.ci_wait_head == null or (.ci_wait_head | type) == "string") and
		(.ci_wait_rule == null or (.ci_wait_rule | type) == "string") and
		(.ci_wait_since == null or (.ci_wait_since | type == "number" and . >= 0 and . == floor))' <<<"$task" >/dev/null; then
		echo 'CI 待ちの metadata の形式が不正です。' >&2
		return 1
	fi
	head=$(jq -r '.metadata.ci_wait_head | select(. != null)' <<<"$task")
	since=$(jq -r '.metadata.ci_wait_since | select(. != null)' <<<"$task")
	case $(jq -r '.status_category' <<<"$task") in
	done | cancelled)
		ci_wait_clear "$issue" "$task" || return 1
		echo 'CI 待ち: タスクが終わっている'
		return 0
		;;
	esac
	# GitHub を読む前に検証し、規則を作ったあとの読み直しにも同じ正規形を使う。
	data=$(pr_url_data "$task") || return 1
	case $(jq -r .state <<<"$data") in
	valid) pr_url=$(jq -r .url <<<"$data") ;;
	absent) pr_url= ;;
	*)
		# 残した規則が 30 分後に起きて同じ理由で人間を呼ばないよう、待ちを消してから終える。
		ci_wait_clear "$issue" "$task" >/dev/null || true
		jq -r .reason <<<"$data" >&2
		return 1
		;;
	esac
	# 登録の直前に終わった CI は条件で起きないため、登録後にも必ず読む。
	for pass in 1 2; do
		now=$(date +%s)
		state=未確認 new_head= failures='[]'
		if [[ -n $pr_url ]] && pr=$(squad_cli_read gh-pr-checks "$pr_url" 2>/dev/null); then
			new_head=$(jq -r '.headRefOid' <<<"$pr")
			case $(jq -r '.state' <<<"$pr") in
			MERGED | CLOSED)
				ci_wait_finish "$issue" "$task" "$trigger" '[]' "$new_head" 'PR がマージ済みか閉じている' '[]'
				return $?
				;;
			esac
			if [[ -n $new_head && $(jq -r '.state' <<<"$pr") == OPEN ]]; then
				checks=$(jq '.statusCheckRollup' <<<"$pr")
				failures=$(ci_failures "$checks")
				if [[ $(jq length <<<"$checks") == 0 ]]; then state=チェックなし
				elif [[ $(jq length <<<"$failures") != 0 ]]; then state=失敗あり
				elif jq -e 'any(.[];
					if .__typename == "CheckRun" then .status != "COMPLETED"
					elif .__typename == "StatusContext" then (.state != "SUCCESS" and .state != "FAILURE" and .state != "ERROR")
					else true end)' <<<"$checks" >/dev/null; then state=実行中
				elif jq -e 'all(.[];
					if .__typename == "CheckRun" then .status == "COMPLETED" and .conclusion == "SUCCESS"
					elif .__typename == "StatusContext" then .state == "SUCCESS"
					else false end)' <<<"$checks" >/dev/null; then state=成功
				else state=未確認; fi
			fi
		fi
		if [[ -n $new_head && $new_head != "$head" ]]; then head=$new_head; since=$now; fi
		[[ -n $since ]] || since=$now
		comments=$(squad_cli_read issue-comments "$issue") || return 1
		if [[ -n $head ]] && jq -e --arg head "$head" --arg leader "$leader" '
			any(.[]; .author_type == "agent" and .author_id == $leader
				and (.content | split("\n") | index("マージの依頼: " + $head)) != null)' <<<"$comments" >/dev/null; then
			state=マージを依頼済み
		fi
		case $state in
		成功 | チェックなし | 失敗あり | マージを依頼済み)
			ci_wait_finish "$issue" "$task" "$trigger" "$comments" "$head" "$state" "$failures"
			return $?
			;;
		esac
		remaining=$((limit - (now - since)))
		if ((remaining <= 0)); then
			ci_wait_finish "$issue" "$task" "$trigger" "$comments" "$head" "${state}（待つ上限の 2 時間を超えた）" "$failures"
			return $?
		fi
		if ((pass == 1)); then ci_wait_delete_rules "$issue" "$task" || return 1; fi
		multica issue metadata set "$issue" --key ci_wait_head --value "$head" --type string --output json >/dev/null || return 1
		multica issue metadata set "$issue" --key ci_wait_since --value "$since" --type number --output json >/dev/null || return 1
		task=$(jq --arg head "$head" --argjson since "$since" '.metadata += {ci_wait_head:$head, ci_wait_since:$since}' <<<"$task")
		if ((pass == 2)); then
			ci_wait_line "$head" "$state"
			return 0
		fi
		((remaining <= interval)) || remaining=$interval
		mkdir -p tmp
		instruction=$(mktemp tmp/pr-watch-ci-wait.XXXXXX)
		trap "$(printf 'rm -f -- %q' "$instruction")" EXIT
		{
			echo 'CI の待ちの規則で起きました。'
			echo 'タスクとコメントを読み、マージの前の確認を最初から流してください。'
			printf 'CI の待ちは squad-pr-watch ci-wait %q %q %q に、この実行を起こした規則の ID を最後の引数として渡してください。\n' "$issue" "$leader" "$trigger"
			echo '実行中と未確認なら、マージを頼まず人間を呼ばずに待ちます。終了済みの PR とタスク、依頼済みと終わった規則では、依頼も状態変更もしません。'
		} >"$instruction"
		response=$(squad_cli_read issue-wakeup-create "$issue" "$instruction" --until-pr checks --mode once \
			--agent-id "$leader" --parent "$trigger" --expires-in "${remaining}s" --on-timeout wake) || return 1
		rule=$(jq -r '.id' <<<"$response")
		multica issue metadata set "$issue" --key ci_wait_rule --value "$rule" --type string --output json >/dev/null || return 1
		task=$(jq --arg rule "$rule" '.metadata.ci_wait_rule = $rule' <<<"$task")
		rm -f "$instruction"
		trap - EXIT
	done
}

# conflicts と unlinked は、どこにあっても --leader <ID> を受ける。ほかの引数の数え方は変えない。
command=${1:-}
leader_arg=''
if [[ $command == conflicts || $command == unlinked ]]; then
	shift
	positional=()
	while (($#)); do
		if [[ $1 == --leader ]]; then
			[[ -n ${2-} ]] || usage
			leader_arg=$2
			shift 2
		else
			positional+=("$1")
			shift
		fi
	done
	set -- "$command" ${positional[@]+"${positional[@]}"}
fi

case ${1:-} in
link-check)
	(($# == 2)) || usage
	link_check "$2"
	;;
conflicts)
	(($# == 2)) || usage
	require_commands jq python3 multica
	conflicts "$2" "$leader_arg"
	;;
conflicts-check)
	(($# == 2)) || usage
	conflicts_check "$2"
	;;
ci)
	(($# == 4)) || usage
	require_commands jq python3 multica
	ci "$2" "$3" "$4"
	;;
ci-check)
	(($# == 4)) || usage
	require_commands jq python3 multica gh
	ci_check "$2" "$3" "$4"
	;;
ci-now)
	(($# == 4 || $# == 5)) || usage
	require_commands jq python3 multica gh
	ci_check "$2" "$3" "${5-}" now "$4"
	;;
ci-held)
	(($# == 3)) || usage
	require_commands jq python3 multica gh
	ci_held "$2" "$3"
	;;
unlinked)
	(($# == 3 || $# == 4)) || usage
	require_commands jq python3 multica
	unlinked "$2" "$3" "${4-}" "$leader_arg"
	;;
unlinked-check)
	(($# == 3 || $# == 4)) || usage
	require_commands jq python3 multica gh
	unlinked_check "$2" "$3" "${4-}"
	;;
ci-wait)
	(($# == 4 || $# == 5)) || usage
	require_commands jq python3 multica
	ci_wait "$2" "$3" "$4" "${5:-}"
	;;
ci-wait-clear)
	(($# == 2)) || usage
	require_commands jq python3 multica
	ci_wait_clear "$2"
	;;
*) usage ;;
esac
