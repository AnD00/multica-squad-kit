#!/usr/bin/env bash
# multica-squad-kit-managed
# PR のコンフリクトと CI の結果を、タスクの wakeup で拾う。
# 人間に回すたびに 1 回きりの規則を入れ直し、すでにあるコンフリクトも次の確認で拾う。
#
#   squad-pr-watch conflicts <タスク>
#     古いコンフリクトの規則を消し、呼び出した orchestrator 自身を起こす規則を作る。
#   squad-pr-watch conflicts-check <タスク>
#     今の head と mergeable を読み、「コンフリクト: <値> head: <SHA>」の 1 行を必ず標準出力に出す。
#     値は MERGEABLE・CONFLICTING・未確認のどれか。読めないときも「未確認」で、0 で終わる。
#   squad-pr-watch ci <タスク> <見張り役の ID> <きっかけのコメント>
#     CI が終わるたびに見張り役を起こす規則を作る。有効な規則があれば何もしない。
#   squad-pr-watch ci-check <タスク> <リーダーの ID> <見張り役の ID>
#     今の head で確定した CI の失敗があれば、ほかの役の作業中は保留し、それ以外は一度だけ知らせる。
#     0 で終わるときは、記録のスレッドに残す /note と 1 行を標準出力に出す。
#   squad-pr-watch ci-held <タスク> <きっかけのコメント>
#     今の head の未処理の失敗を一度だけ出し、引き継ぎで受けた記録をきっかけへの返信に残す。
#   squad-pr-watch ci-wait <タスク> <リーダー> <きっかけのコメント> [<起きた規則>]
#     CI が成功するまで、2 時間を上限に、リーダーを起こす 1 回きりの規則で待つ。
#   squad-pr-watch ci-wait-clear <タスク>
#     待ちの規則と metadata を消す。
set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/squad-cli-lib"

usage() {
	echo '使い方: squad-pr-watch conflicts <タスク> | conflicts-check <タスク> | ci <タスク> <見張り役の ID> <きっかけのコメント> | ci-check <タスク> <リーダーの ID> <見張り役の ID> | ci-held <タスク> <きっかけのコメント> | ci-wait <タスク> <リーダー> <きっかけのコメント> [<起きた規則>] | ci-wait-clear <タスク>' >&2
	exit 2
}

require_commands() {
	local cmd
	for cmd in "$@"; do
		if ! command -v "$cmd" >/dev/null 2>&1; then
			echo "${cmd} が見つからない。" >&2
			exit 1
		fi
	done
}


conflicts() {
	local issue=$1 rules ids id instruction response
	# CI など、ほかの条件の規則は残す。無効になった古い規則も消してから入れ直す。
	rules=$(squad_cli_read issue-wakeups "$issue")
	ids=$(jq -r '.[] | select(.condition.type == "pull_request" and .condition.event == "conflicts") | .id' <<<"$rules")
	while IFS= read -r id; do
		[[ -n $id ]] || continue
		multica issue wakeup delete "$issue" "$id" --output json >/dev/null
	done <<<"$ids"

	# 作業ディレクトリの tmp/ に置く。Multica は登録時に本文を読み込むので、登録後は消せる。
	mkdir -p tmp
	instruction=$(mktemp tmp/pr-watch-conflicts.XXXXXX)
	# EXIT の時点では関数の local が消えていることがあるので、パスはここで埋め込む。
	trap "$(printf 'rm -f -- %q' "$instruction")" EXIT
	cat >"$instruction" <<'EOF'
PR のコンフリクトの見張りで起きました。
タスクの状態とコメントを読み、in_review で、最後に人間を呼んだのがマージを待つためかを確認してください。
マージ待ちで、レビューと E2E の返事を待つ回の途中でなければ、リーダーの「実装・修正の振り分け」に従い、有効な修正の役を選んでください。選んだ役にタスクの metadata の pr_url を書いて、main とのコンフリクトの解消を頼み、タスクを in_progress にしてください。
そうでなければ、何もせずに終えてください。作業中のコンフリクトは、次にマージに回すときに入れ直す見張りが拾います。
EOF
	# --agent-id を省くと、呼び出した orchestrator 自身を起こす。既定の mode は once。
	response=$(squad_cli_read issue-wakeup-create "$issue" "$instruction" --until-pr conflicts)
	jq '{id}' <<<"$response"
	rm -f "$instruction"
	trap - EXIT
}

# 結果は、どの場合も標準出力の 1 行にする。値は MERGEABLE・CONFLICTING・未確認のどれか。
# 「なし」の語は使わない。読み違えを防ぐため、失敗でも終了コード 0 で終える。
conflicts_check_line() {
	local value=$1 head=$2 reason=${3:-}
	printf 'コンフリクト: %s head: %s' "$value" "$head"
	if [[ -n $reason ]]; then
		printf ' 理由: %s' "$reason"
	fi
	printf '\n'
}

conflicts_check() {
	local issue=$1 cmd task pr_url pr head new state mergeable start now remain wait
	# mergeable は push の直後に UNKNOWN になりやすい。10 秒おきに、最初の読み取りから 60 秒まで読み直す。
	local interval=10 limit=60
	head=不明
	for cmd in jq multica gh; do
		if ! command -v "$cmd" >/dev/null 2>&1; then
			conflicts_check_line 未確認 不明 "${cmd} が見つからない"
			return 0
		fi
	done
	if ! task=$(multica issue get "$issue" --output json) || ! pr_url=$(jq -r '.metadata.pr_url // empty' <<<"$task"); then
		conflicts_check_line 未確認 不明 'タスクを読めない'
		return 0
	fi
	if [[ -z $pr_url ]]; then
		conflicts_check_line 未確認 不明 'metadata に pr_url がない'
		return 0
	fi
	start=$(date +%s)
	while :; do
		# 共通の応答契約で読む。state・headRefOid・mergeable のどれかが欠けた応答は、「未確認」にする。
		if ! pr=$(squad_cli_read gh-pr-mergeable "$pr_url") \
			|| ! new=$(jq -r '.headRefOid' <<<"$pr") || [[ -z $new ]]; then
			conflicts_check_line 未確認 "$head" 'PR を読めない（gh の失敗か必須欄の欠落）'
			return 0
		fi
		head=$new
		state=$(jq -r '.state' <<<"$pr")
		case $state in
		MERGED | CLOSED)
			conflicts_check_line 未確認 "$head" 'PR がマージ済みか閉じている'
			return 0
			;;
		esac
		mergeable=$(jq -r '.mergeable' <<<"$pr")
		case $mergeable in
		MERGEABLE | CONFLICTING)
			conflicts_check_line "$mergeable" "$head"
			return 0
			;;
		UNKNOWN) ;;
		*)
			conflicts_check_line 未確認 "$head" "mergeable が想定外の値 ${mergeable:-空}"
			return 0
			;;
		esac
		# 新しい読み取りは、60 秒までしか始めない。待ちは、残り時間を超えない。
		now=$(date +%s)
		remain=$((limit - (now - start)))
		if ((remain <= 0)); then
			break
		fi
		wait=$interval
		if ((remain < wait)); then
			wait=$remain
		fi
		sleep "$wait"
	done
	conflicts_check_line 未確認 "$head" "mergeable が ${limit} 秒たっても UNKNOWN"
}

ci() {
	local issue=$1 monitor=$2 trigger=$3 id rules paused old old_id instruction task thread status response
	id=$monitor
	rules=$(squad_cli_read issue-wakeups "$issue" | jq --arg id "$id" '
		[.[] | select(.agent_id == $id and .mode == "continuous"
			and .condition.type == "pull_request" and .condition.event == "checks_finished")]')
	# 暴走の防止で止まった規則は、作り直して解除しない。
	paused=$(jq -r '[.[] | select(.paused_reason == "loop" or .paused_reason == "rate") | .paused_reason] | unique | join(", ")' <<<"$rules")
	if [[ -n $paused ]]; then
		echo "CI の見張りが止まっています（${paused}）。次に人間を呼ぶコメントに添えてください。"
		return 0
	fi
	if jq -e 'any(.[]; .enabled == true)' <<<"$rules" >/dev/null; then
		return 0
	fi
	# 規則を消して入れ直しても、タスクごとの同じ記録のスレッドに続ける。
	task=$(squad_cli_read issue-get "$issue")
	thread=$(jq -r '.metadata.ci_watch_thread | select(. != null)' <<<"$task")
	if [[ -n $thread ]]; then
		if multica issue comment list "$issue" --thread "$thread" --tail 0 --compact --output json >/dev/null; then
			:
		else
			status=$?
			# CLI の終了コード 4 は 404。それ以外は記録先も規則も変えず、エラーを返す。
			((status == 4)) || return "$status"
			thread=
		fi
	fi
	if [[ -z $thread ]]; then
		# コメントで起きた実行は、きっかけへの返信しか書けない。根のコメントは作らない。
		thread=$trigger
		multica issue metadata set "$issue" --key ci_watch_thread --value "$thread" --output json >/dev/null
	fi
	# max_fires に達した規則など、有効でなくなった古い規則は入れ直す。
	old=$(jq -r '.[].id' <<<"$rules")
	while IFS= read -r old_id; do
		[[ -n $old_id ]] || continue
		multica issue wakeup delete "$issue" "$old_id" --output json >/dev/null
	done <<<"$old"
	mkdir -p tmp
	instruction=$(mktemp tmp/pr-watch-ci.XXXXXX)
	trap "$(printf 'rm -f -- %q' "$instruction")" EXIT
	cat >"$instruction" <<'EOF'
PR の CI が終わりました。あなたの指示に従い、「このプロジェクトの値」からリーダーと見張り役の ID を渡して squad-pr-watch ci-check で今の head の CI を確認してください。
判定と失敗の知らせはスクリプトが行います。スクリプトが 0 で終わったら、標準出力をそのまま最後の返答にしてください。
EOF
	printf '記録のスレッド: %s（0 以外で終わったときの返信先）\n' "$thread" >>"$instruction"
	response=$(squad_cli_read issue-wakeup-create "$issue" "$instruction" --until-pr checks --mode continuous --agent-id "$id" \
		--max-fires 200 --parent "$thread")
	jq '{id}' <<<"$response"
	rm -f "$instruction"
	trap - EXIT
}

ci_record() {
	printf '/note\n%s\n' "$1"
}

# ci-check と ci-held は同じ結論を失敗として扱う。
ci_failures() {
	jq '[.[]
		| select((.__typename == "CheckRun" and .status == "COMPLETED" and (.conclusion == "FAILURE" or .conclusion == "TIMED_OUT" or .conclusion == "STARTUP_FAILURE"))
			or (.__typename == "StatusContext" and (.state == "FAILURE" or .state == "ERROR")))
		| if .__typename == "CheckRun" then
			(if .workflowName != "" then .workflowName + " / " else "" end) + .name
		  else .context end] | unique' <<<"$1"
}

ci_handled() {
	jq -e --arg prefix "head: ${2}"$'\nCI の失敗を検出しました。' \
		--arg received "/note"$'\n'"CI ${2}: 保留した失敗を" '
		any(.[]; .author_type == "agent" and
			((.content | startswith($prefix)) or
			 (.content | rtrimstr("\n") | startswith($received) and endswith("が引き継ぎで受けた"))))
	' <<<"$1" >/dev/null
}

ci_check() {
	local issue=$1 id=$2 monitor_id=$3 orchestrator task thread pr_url pr checks failures head short comments body runs active names role name agent squad handoffs notice target selection_status
	task=$(squad_cli_read issue-get "$issue")
	thread=$(jq -r '.metadata.ci_watch_thread | select(. != null)' <<<"$task")
	if [[ -z $thread ]]; then
		echo 'metadata に ci_watch_thread がありません。CI の見張りを登録し直してください。' >&2
		return 1
	fi
	case $(jq -r '.status_category' <<<"$task") in
	done | cancelled)
		ci_record 'CI: タスクが終わっているので見ない'
		return 0
		;;
	esac
	pr_url=$(jq -er '.metadata.pr_url | select(. != null)' <<<"$task")
	pr=$(squad_cli_read gh-pr-checks "$pr_url")
	head=$(jq -er '.headRefOid | select(length > 0)' <<<"$pr")
	short=${head:0:7}
	case $(jq -r .state <<<"$pr") in
	MERGED | CLOSED)
		ci_record "CI ${short}: PR がマージ済みか閉じているので見ない"
		return 0
		;;
	esac
	checks=$(jq '.statusCheckRollup' <<<"$pr")
	if [[ $(jq length <<<"$checks") == 0 ]]; then
		ci_record "CI ${short}: チェックなし"
		return 0
	fi
	# 失敗が確定した時点で wakeup は発火する。同じ head の失敗では発火し直さないため、
	# ほかのチェックの終了は待たない。CANCELLED は失敗に数えない。
	failures=$(ci_failures "$checks")
	if [[ $(jq length <<<"$failures") == 0 ]]; then
		if jq -e 'any(.[];
			if .__typename == "CheckRun" then .status != "COMPLETED"
			elif .__typename == "StatusContext" then (.state != "SUCCESS" and .state != "FAILURE" and .state != "ERROR")
			else true end)' <<<"$checks" >/dev/null; then
			ci_record "CI ${short}: 失敗なし（実行中のチェックあり）"
		else
			ci_record "CI ${short}: 失敗なし"
		fi
		return 0
	fi
	# 取得記録は起点への返信なので、別のスレッドや解決済みの記録も含めて重複を防ぐ。
	# source_task_id で、run が終わる前に投稿された引き継ぎを対応付ける。
	comments=$(squad_cli_read issue-comments "$issue")
	if ci_handled "$comments" "$short"; then
		ci_record "CI ${short}: 失敗は知らせ済み"
		return 0
	fi
	agent=$(squad_cli_read agent-get "$id")
	orchestrator=$(jq -r '.name' <<<"$agent")
	runs=$(squad_cli_read issue-runs "$issue")
	# 引き継ぎ後も run は短時間 running のまま残る。引き継ぎ済みの run では
	# 保留しない。取得の確認より後に確定した失敗も、通常の通知で拾えるようにする。
	# 引き継ぎは、担当のスクワッドへのメンション（今の形式）か、リーダーへのエージェントのメンション。
	squad=$(jq -r 'select(.assignee_type == "squad") | .assignee_id | select(. != null)' <<<"$task")
	handoffs=$(jq -cn --arg agent "mention://agent/${id})" --arg squad "$squad" \
		'[$agent] + if $squad != "" then ["mention://squad/" + $squad + ")"] else [] end')
	active=$(jq -r --arg id "$id" --arg monitor "$monitor_id" --argjson comments "$comments" \
		--argjson handoffs "$handoffs" --arg report $'/note\n確認したコミット:' '[.[] | . as $run
		| select(.agent_id != null and .agent_id != $id and .agent_id != $monitor
			and .status != "completed" and .status != "failed" and .status != "cancelled")
		| select(any($comments[]; $run.id != null and .source_task_id == $run.id
			and .author_type == "agent" and .author_id == $run.agent_id
			and (.content | . as $content | startswith($report) or any($handoffs[]; . as $handoff | $content | contains($handoff)))) | not)
		| .agent_id] | unique | .[]' <<<"$runs")
	if [[ -n $active ]]; then
		names=''
		while IFS= read -r role; do
			agent=$(squad_cli_read agent-get "$role")
			name=$(jq -r '.name' <<<"$agent")
			names+="${names:+、}${name}"
		done <<<"$active"
		ci_record "CI ${short}: 失敗あり（${names} の作業中なので保留）"
		return 0
	fi
	# 欄の検証と通信の失敗は通知にすり替えない。候補が 0 件・複数のときだけ従来の通知先へ戻す。
	if target=$(squad_cli_squad_for_leader "$id"); then
		notice=$(jq -r '"[@" + .name + "](mention://squad/" + .id + ")"' <<<"$target")
	else
		selection_status=$?
		((selection_status == 2)) || return "$selection_status"
		notice="[@${orchestrator}](mention://agent/${id})"
	fi
	mkdir -p tmp
	body=$(mktemp tmp/pr-watch-ci-result.XXXXXX)
	trap "$(printf 'rm -f -- %q' "$body")" EXIT
	{
		printf 'head: %s\nCI の失敗を検出しました。\n\n%s\n\nPR: %s\n\n失敗したチェック:\n' "$short" "$notice" "$pr_url"
		jq -r '.[] | "- " + .' <<<"$failures"
	} >"$body"
	# Actions の URL は書かず、PR とチェックの名前で知らせる。
	multica issue comment add "$issue" --parent "$thread" --content-file "$body" --output table >/dev/null
	rm -f "$body"
	trap - EXIT
	ci_record "CI ${short}: 失敗をリーダーに知らせた"
}

ci_held() {
	local issue=$1 trigger=$2 task thread pr_url pr head short failures comments received body
	task=$(squad_cli_read issue-get "$issue")
	case $(jq -r '.status_category' <<<"$task") in
	done | cancelled) return 0 ;;
	esac
	thread=$(jq -r '.metadata.ci_watch_thread | select(. != null)' <<<"$task")
	[[ -n $thread ]] || return 0
	pr_url=$(jq -er '.metadata.pr_url | select(. != null)' <<<"$task")
	pr=$(squad_cli_read gh-pr-checks "$pr_url")
	case $(jq -r .state <<<"$pr") in
	MERGED | CLOSED) return 0 ;;
	esac
	head=$(jq -er '.headRefOid | select(length > 0)' <<<"$pr")
	short=${head:0:7}
	failures=$(ci_failures "$(jq '.statusCheckRollup' <<<"$pr")")
	[[ $(jq length <<<"$failures") != 0 ]] || return 0
	comments=$(squad_cli_read issue-comments "$issue")
	if ci_handled "$comments" "$short"; then
		return 0
	fi
	# 見張り役の保留コメントより先に引き継ぎが届くことがある。
	# 保留の投稿を待たず、GitHub で確定した今の head の失敗を拾う。
	received="CI ${short}: 保留した失敗をリーダーが引き継ぎで受けた"
	mkdir -p tmp
	body=$(mktemp tmp/pr-watch-ci-held.XXXXXX)
	trap "$(printf 'rm -f -- %q' "$body")" EXIT
	ci_record "$received" >"$body"
	multica issue comment add "$issue" --parent "$trigger" --content-file "$body" --output table >/dev/null
	rm -f "$body"
	trap - EXIT
	jq -r '.[]' <<<"$failures"
}

# 継続的な CI 見張りやコンフリクトの規則は残し、待ち専用の規則だけを消す。
ci_wait_delete_rules() {
	local issue=$1 task=$2 rules ids id
	rules=$(squad_cli_read issue-wakeups "$issue") || return 1
	ids=$(jq -r --arg old "$(jq -r '.metadata.ci_wait_rule | select(. != null)' <<<"$task")" '
		.[] | select(.id == $old or (.mode == "once"
			and .condition.type == "pull_request" and .condition.event == "checks_finished"
			and (.instruction | startswith("CI の待ちの規則で起きました。")))) | .id' <<<"$rules")
	while IFS= read -r id; do
		[[ -n $id ]] || continue
		multica issue wakeup delete "$issue" "$id" --output json >/dev/null || return 1
	done <<<"$ids"
}

ci_wait_clear() {
	local issue=$1 task=${2:-} key
	[[ -n $task ]] || task=$(squad_cli_read issue-get "$issue") || return 1
	ci_wait_delete_rules "$issue" "$task" || return 1
	for key in ci_wait_rule ci_wait_head ci_wait_since; do
		if jq -e --arg key "$key" '.metadata | has($key)' <<<"$task" >/dev/null; then
			multica issue metadata delete "$issue" --key "$key" --output json >/dev/null || return 1
		fi
	done
}

ci_wait_line() {
	local head=$1 state=$2
	printf 'CI%s: %s\n' "${head:+ $head}" "$state"
}

ci_wait_finish() {
	local issue=$1 task=$2 trigger=$3 comments=$4 head=$5 state=$6 failures=$7 body
	if [[ $state == 失敗あり ]] && ! ci_handled "$comments" "${head:0:7}"; then
		mkdir -p tmp
		body=$(mktemp tmp/pr-watch-ci-wait-held.XXXXXX)
		trap "$(printf 'rm -f -- %q' "$body")" EXIT
		ci_record "CI ${head:0:7}: 保留した失敗をリーダーが引き継ぎで受けた" >"$body"
		multica issue comment add "$issue" --parent "$trigger" --content-file "$body" --output table >/dev/null || return 1
		rm -f "$body"
		trap - EXIT
	fi
	ci_wait_clear "$issue" "$task" || return 1
	ci_wait_line "$head" "$state"
	if [[ $state == 失敗あり ]]; then jq -r '.[]' <<<"$failures"; fi
}

ci_wait() {
	local issue=$1 leader=$2 trigger=$3 fired=${4:-} task head since now pass pr_url pr new_head checks failures state comments
	local instruction response rule remaining key
	local limit=7200 interval=1800
	task=$(squad_cli_read issue-get "$issue") || return 1
	# 削除の直前に起動が決まっていた規則も、今の規則と違えば何もせず終える。
	if [[ -n $fired ]] && ! jq -e --arg fired "$fired" '
		.metadata | has("ci_wait_head") and .ci_wait_since != null and .ci_wait_rule == $fired' <<<"$task" >/dev/null; then
		echo 'CI 待ち: 終わった規則で起きた'
		return 0
	fi
	if ! jq -e '.metadata |
		(.ci_wait_head == null or (.ci_wait_head | type) == "string") and
		(.ci_wait_rule == null or (.ci_wait_rule | type) == "string") and
		(.ci_wait_since == null or (.ci_wait_since | type == "number" and . >= 0 and . == floor))' <<<"$task" >/dev/null; then
		echo 'CI 待ちの metadata の形式が不正です。' >&2
		return 1
	fi
	head=$(jq -r '.metadata.ci_wait_head | select(. != null)' <<<"$task")
	since=$(jq -r '.metadata.ci_wait_since | select(. != null)' <<<"$task")
	case $(jq -r '.status_category' <<<"$task") in
	done | cancelled)
		ci_wait_clear "$issue" "$task" || return 1
		echo 'CI 待ち: タスクが終わっている'
		return 0
		;;
	esac
	pr_url=$(jq -r '.metadata.pr_url | select(. != null)' <<<"$task")
	# 登録の直前に終わった CI は条件で起きないため、登録後にも必ず読む。
	for pass in 1 2; do
		now=$(date +%s)
		state=未確認 new_head= failures='[]'
		if [[ -n $pr_url ]] && pr=$(squad_cli_read gh-pr-checks "$pr_url" 2>/dev/null); then
			new_head=$(jq -r '.headRefOid' <<<"$pr")
			case $(jq -r '.state' <<<"$pr") in
			MERGED | CLOSED)
				ci_wait_finish "$issue" "$task" "$trigger" '[]' "$new_head" 'PR がマージ済みか閉じている' '[]'
				return $?
				;;
			esac
			if [[ -n $new_head && $(jq -r '.state' <<<"$pr") == OPEN ]]; then
				checks=$(jq '.statusCheckRollup' <<<"$pr")
				failures=$(ci_failures "$checks")
				if [[ $(jq length <<<"$checks") == 0 ]]; then state=チェックなし
				elif [[ $(jq length <<<"$failures") != 0 ]]; then state=失敗あり
				elif jq -e 'any(.[];
					if .__typename == "CheckRun" then .status != "COMPLETED"
					elif .__typename == "StatusContext" then (.state != "SUCCESS" and .state != "FAILURE" and .state != "ERROR")
					else true end)' <<<"$checks" >/dev/null; then state=実行中
				elif jq -e 'all(.[];
					if .__typename == "CheckRun" then .status == "COMPLETED" and .conclusion == "SUCCESS"
					elif .__typename == "StatusContext" then .state == "SUCCESS"
					else false end)' <<<"$checks" >/dev/null; then state=成功
				else state=未確認; fi
			fi
		fi
		if [[ -n $new_head && $new_head != "$head" ]]; then head=$new_head; since=$now; fi
		[[ -n $since ]] || since=$now
		comments=$(squad_cli_read issue-comments "$issue") || return 1
		if [[ -n $head ]] && jq -e --arg head "$head" --arg leader "$leader" '
			any(.[]; .author_type == "agent" and .author_id == $leader
				and (.content | split("\n") | index("マージの依頼: " + $head)) != null)' <<<"$comments" >/dev/null; then
			state=マージを依頼済み
		fi
		case $state in
		成功 | チェックなし | 失敗あり | マージを依頼済み)
			ci_wait_finish "$issue" "$task" "$trigger" "$comments" "$head" "$state" "$failures"
			return $?
			;;
		esac
		remaining=$((limit - (now - since)))
		if ((remaining <= 0)); then
			ci_wait_finish "$issue" "$task" "$trigger" "$comments" "$head" "${state}（待つ上限の 2 時間を超えた）" "$failures"
			return $?
		fi
		if ((pass == 1)); then ci_wait_delete_rules "$issue" "$task" || return 1; fi
		multica issue metadata set "$issue" --key ci_wait_head --value "$head" --type string --output json >/dev/null || return 1
		multica issue metadata set "$issue" --key ci_wait_since --value "$since" --type number --output json >/dev/null || return 1
		task=$(jq --arg head "$head" --argjson since "$since" '.metadata += {ci_wait_head:$head, ci_wait_since:$since}' <<<"$task")
		if ((pass == 2)); then
			ci_wait_line "$head" "$state"
			return 0
		fi
		((remaining <= interval)) || remaining=$interval
		mkdir -p tmp
		instruction=$(mktemp tmp/pr-watch-ci-wait.XXXXXX)
		trap "$(printf 'rm -f -- %q' "$instruction")" EXIT
		{
			echo 'CI の待ちの規則で起きました。'
			echo 'タスクとコメントを読み、マージの前の確認を最初から流してください。'
			printf 'CI の待ちは squad-pr-watch ci-wait %q %q %q に、この実行を起こした規則の ID を最後の引数として渡してください。\n' "$issue" "$leader" "$trigger"
			echo '実行中と未確認なら、マージを頼まず人間を呼ばずに待ちます。終了済みの PR とタスク、依頼済みと終わった規則では、依頼も状態変更もしません。'
		} >"$instruction"
		response=$(squad_cli_read issue-wakeup-create "$issue" "$instruction" --until-pr checks --mode once \
			--agent-id "$leader" --parent "$trigger" --expires-in "${remaining}s" --on-timeout wake) || return 1
		rule=$(jq -r '.id' <<<"$response")
		multica issue metadata set "$issue" --key ci_wait_rule --value "$rule" --type string --output json >/dev/null || return 1
		task=$(jq --arg rule "$rule" '.metadata.ci_wait_rule = $rule' <<<"$task")
		rm -f "$instruction"
		trap - EXIT
	done
}

case ${1:-} in
conflicts)
	(($# == 2)) || usage
	require_commands jq python3 multica
	conflicts "$2"
	;;
conflicts-check)
	(($# == 2)) || usage
	conflicts_check "$2"
	;;
ci)
	(($# == 4)) || usage
	require_commands jq python3 multica
	ci "$2" "$3" "$4"
	;;
ci-check)
	(($# == 4)) || usage
	require_commands jq python3 multica gh
	ci_check "$2" "$3" "$4"
	;;
ci-held)
	(($# == 3)) || usage
	require_commands jq python3 multica gh
	ci_held "$2" "$3"
	;;
ci-wait)
	(($# == 4 || $# == 5)) || usage
	require_commands jq python3 multica
	ci_wait "$2" "$3" "$4" "${5:-}"
	;;
ci-wait-clear)
	(($# == 2)) || usage
	require_commands jq python3 multica
	ci_wait_clear "$2"
	;;
*) usage ;;
esac
