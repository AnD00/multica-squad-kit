#!/usr/bin/env bash
# multica-squad-kit-managed
# 実装・修正・最上位の役を回す側を、その場で読んだ使用率から選ぶ（macOS・Linux 用）。
# 0: 選択、2: 両方とも使用上限、1: 使い方などの誤り。Multica には書き込まない。
set -euo pipefail

dispatch_pick_main() (
	local kind=${1:-} size=${2:-大きな}
	if [[ "$kind" != implement && "$kind" != fix && "$kind" != principal ]] || (($# > 2)) \
		|| { [[ "$kind" != implement ]] && (($# != 1)); }; then
		echo '使い方: squad-dispatch-pick implement [小さな|大きな]、squad-dispatch-pick fix、または squad-dispatch-pick principal' >&2
		return 1
	fi
	command -v jq >/dev/null 2>&1 || { echo 'jq が見つからない' >&2; return 1; }
	[[ "$size" == 小さな ]] || size=大きな
	local script_dir status=0 ticks usage result reason= now
	reader_pid=
	script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
	mkdir -p "$PWD/tmp"
	work_dir=$(mktemp -d "$PWD/tmp/dispatch-pick.XXXXXX")
	# 読み取りを独立したプロセスグループで始める。時間切れや中断のときは、
	# squad-usage-read が呼んだ CLI とその子も止め、実行を残さない。
	# グループは、set -m ではなく子が自分で作る。set -m は親と子の両方が setpgid を呼び、
	# 負荷が高いと子の側が失敗して、標準エラーに警告を出すため。
	# 子がグループを作る前は、グループがないので、読み取りのプロセスに直接 kill する。
	# その時点の読み取りは、まだ子を起こしていない。
	stop_reader() {
		kill -"$1" -- "-$reader_pid" 2>/dev/null || kill -"$1" -- "$reader_pid" 2>/dev/null || true
	}
	trap 'if [[ -n "$reader_pid" ]]; then
		stop_reader TERM
		stop_reader KILL
		wait "$reader_pid" 2>/dev/null || true
	fi
	rm -rf -- "$work_dir"' EXIT
	trap 'exit 1' HUP INT TERM
	python3 -c 'import os, sys; os.setpgrp(); os.execvp(sys.argv[1], sys.argv[1:])' \
		bash "$script_dir/squad-usage-read" >"$work_dir/usage.json" 2>"$work_dir/usage.err" &
	reader_pid=$!
	for ((ticks = 0; ticks < 90; ticks++)); do
		kill -0 "$reader_pid" 2>/dev/null || break
		sleep 1
	done
	if kill -0 "$reader_pid" 2>/dev/null; then
		reason='使用率の読み取りが 90 秒で終わらなかった'
		stop_reader TERM
		stop_reader KILL
	fi
	wait "$reader_pid" 2>/dev/null || status=$?
	# 正常終了した読み取りでも、残った子があれば片付ける。
	# 読み取りは終わっているので、プロセスの ID への kill は使わない（別のプロセスに当たりうる）。
	kill -KILL -- "-$reader_pid" 2>/dev/null || true
	reader_pid=
	if [[ -n "$reason" ]]; then
		usage='{}'
	elif ! jq -se 'length == 1 and (.[0] | type) == "object"' "$work_dir/usage.json" >/dev/null 2>&1; then
		usage='{}'
		reason='使用率の出力を JSON として読めなかった'
	else
		usage=$(cat "$work_dir/usage.json")
	fi
	now=$(date '+%s')
	result=$(jq -cn --argjson usage "$usage" --argjson now "$now" --argjson status "$status" \
		--arg kind "$kind" --arg size "$size" --arg reason "$reason" '
		# squad-usage-read の RFC3339（Z と時差付き）の両方を、同じ秒数にする。
		def timestamp:
			(try (capture("^(?<date>[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2})(?<zone>Z|[+-][0-9]{2}:[0-9]{2})$")
				| (.date + "Z" | fromdateiso8601) as $utc
				| if .zone == "Z" then $utc else
					((.zone[1:3] | tonumber) * 3600 + (.zone[4:6] | tonumber) * 60) as $offset
					| $utc - ($offset * (if .zone[0:1] == "-" then -1 else 1 end))
				end) catch null) // null;
		def percent: type == "number" and . >= 0;
		def side($name; $read):
			try ((.week.resets_at | timestamp) as $reset
			| if (.error | type) == "string" then {error: ($name + ": " + .error)}
			elif ((.week.used_percent | percent) and $reset != null
				and (if $name == "Claude" then (.session.used_percent | percent)
					else (.allowed | type) == "boolean" end)) then
				([0, ([1, (1 - ($reset - $read) / 604800)] | min)] | max) as $elapsed
				| ([10, (80 * $elapsed)] | max) as $budget
				| {week: .week.used_percent, session: .session.used_percent, budget: $budget,
					margin: ($budget - .week.used_percent),
					excluded: ([if .week.used_percent >= 80 then $name + " は週の使用率が 80% 以上" else empty end,
						if $name == "Claude" and .session.used_percent >= 80 then "Claude は 5 時間の枠が 80% 以上" else empty end,
						if $name == "Codex" and .allowed == false then "Codex は利用不可" else empty end] | join("、"))}
			else {error: ($name + ": 使用率・リセット時刻・利用可否を読めなかった")} end)
			catch {error: ($name + ": 使用率・リセット時刻・利用可否を読めなかった")};
		def summary($name):
			if has("error") then empty else
				$name + " 週 \(.week | round)%（使ってよい量 \(.budget | round)%）"
				+ (if $name == "Claude" then "・5 時間 \(.session | round)%" else "" end) end;
		($usage.read_at | timestamp) as $read
		| (if $reason != "" then $reason
			elif $read == null then "使用率を読んだ時刻を読めなかった"
			elif $now - $read > 1800 then "使用率が 30 分より古い" else "" end) as $global
		| (if $global != "" then {claude: {error: $global}, codex: {error: $global}}
			else {claude: ($usage.claude | side("Claude"; $read)), codex: ($usage.codex | side("Codex"; $read))} end) as $sides
		| $sides.claude as $c | $sides.codex as $x
		| ($status != 0 or $c.error != null or $x.error != null) as $fallback
		| ([$c.excluded, $x.excluded] | map(select(. != null and . != ""))) as $excluded
		| (if $c.excluded != null and $c.excluded != "" and $x.excluded != null and $x.excluded != "" then "なし"
			elif $c.excluded != null and $c.excluded != "" then "Codex"
			elif $x.excluded != null and $x.excluded != "" then "Claude"
			elif $fallback then (if $kind == "principal" then (if $c.error == null and $x.error != null then "Claude" else "Codex" end)
				elif $kind == "fix" or $size == "小さな" then "Codex" else "Claude" end)
			elif $c.margin >= $x.margin then "Claude" else "Codex" end) as $chosen
		| ((if $fallback then
			["使用率を読めないため、" + (if $kind == "fix" then "修正の代わりの決まり" elif $kind == "principal" then "最上位の役の代わりの決まり" else "大きさ「" + $size + "」" end) + "で決めた。"
				+ (if $global != "" then $global else
					([$c.error, $x.error] | map(select(. != null)) | if length == 0 then ["使用率の読み取りに失敗した"] else . end | join("、")) end)]
			else [] end) + $excluded) as $reasons
		| {chosen: $chosen, role: (if $chosen == "なし" then "なし" else ($chosen | ascii_downcase) + "-" + (if $kind == "fix" then "fixer" elif $kind == "principal" then "principal" else "implementer" end) end),
			line: ("振り分け: " + $chosen + (if $reasons | length > 0 then "（" + ($reasons | join("。")) + "）" else "" end)
				+ "。" + ([($c | summary("Claude")), ($x | summary("Codex"))] | join("、")))}')
	jq -r '"役: " + .role, .line' <<<"$result"
	[[ $(jq -r '.chosen' <<<"$result") != なし ]] || return 2
)

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
	dispatch_pick_main "$@"
fi
