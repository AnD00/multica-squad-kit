#!/usr/bin/env bash
# multica-squad-kit-managed
# 使用量を読む関数。呼び出し元が source して使う。
source "$(dirname "${BASH_SOURCE[0]}")/squad-cli-lib"

# BSD/GNU date のオプションに依存せず、ホストの TZ で表示する。
usage_epoch_format() {
	python3 - "$1" "$2" <<'PY'
import sys
from datetime import datetime

print(datetime.fromtimestamp(int(sys.argv[1])).astimezone().strftime(sys.argv[2]))
PY
}

# 一時ファイルは実行の作業ディレクトリの中に置く。
usage_tmpfile() {
	mkdir -p "$PWD/tmp" || return 1
	mktemp "$PWD/tmp/squad-usage.XXXXXX"
}

# Claude: /usage の表示を読む。モデルを呼ばないので、使用量を消費しない。
# 枠ごとに「名前<TAB>使用率<TAB>リセットの表示」の行を出す。
read_claude_usage() {
	# stderr は分けて受ける。設定の警告などが stdout の JSON に混ざると、読めなくなるため。
	local out err_file
	err_file=$(usage_tmpfile)
	if ! out=$(claude -p "/usage" --output-format json 2>"$err_file"); then
		echo "claude -p /usage が失敗した: ${out} $(cat "$err_file")" >&2
		rm -f "$err_file"
		return 1
	fi
	rm -f "$err_file"
	if ! jq -e '.is_error == false' <<<"$out" >/dev/null 2>&1; then
		echo "claude -p /usage がエラーを返した: $(jq -r '.result // .' <<<"$out" 2>/dev/null || echo "$out")" >&2
		return 1
	fi
	local rows
	rows=$(jq -r '
		.result | split("\n")[]
		| capture("^(?<name>[^:]+): (?<percent>[0-9]+)% used · resets (?<reset>.+)$")
		| [.name, .percent, .reset] | @tsv' <<<"$out")
	if [[ -z "$rows" ]]; then
		# 表示の形が変わったか、サブスクリプションではなく API キーで動いている。
		echo "/usage の表示から使用率を読めなかった: $(jq -r '.result' <<<"$out" | head -n 3)" >&2
		return 1
	fi
	printf '%s\n' "$rows"
}

# Codex の JSON-RPC も、同じ読み取りの入口で検証してから返す。
read_codex_usage() {
	squad_cli_read codex-rate-limits
}
