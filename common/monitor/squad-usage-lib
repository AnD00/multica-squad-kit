#!/usr/bin/env bash
# multica-squad-kit-managed
# 使用量を読む関数。呼び出し元が source して使う。

# 一時ファイルは実行の作業ディレクトリの中に置く。
usage_tmpfile() {
	mkdir -p "$PWD/tmp" || return 1
	mktemp "$PWD/tmp/squad-usage.XXXXXX"
}

# Claude: /usage の表示を読む。モデルを呼ばないので、使用量を消費しない。
# 枠ごとに「名前<TAB>使用率<TAB>リセットの表示」の行を出す。
read_claude_usage() {
	# stderr は分けて受ける。設定の警告などが stdout の JSON に混ざると、読めなくなるため。
	local out err_file
	err_file=$(usage_tmpfile)
	if ! out=$(claude -p "/usage" --output-format json 2>"$err_file"); then
		echo "claude -p /usage が失敗した: ${out} $(cat "$err_file")" >&2
		rm -f "$err_file"
		return 1
	fi
	rm -f "$err_file"
	if ! jq -e '.is_error == false' <<<"$out" >/dev/null 2>&1; then
		echo "claude -p /usage がエラーを返した: $(jq -r '.result // .' <<<"$out" 2>/dev/null || echo "$out")" >&2
		return 1
	fi
	local rows
	rows=$(jq -r '
		.result | split("\n")[]
		| capture("^(?<name>[^:]+): (?<percent>[0-9]+)% used · resets (?<reset>.+)$")
		| [.name, .percent, .reset] | @tsv' <<<"$out")
	if [[ -z "$rows" ]]; then
		# 表示の形が変わったか、サブスクリプションではなく API キーで動いている。
		echo "/usage の表示から使用率を読めなかった: $(jq -r '.result' <<<"$out" | head -n 3)" >&2
		return 1
	fi
	printf '%s\n' "$rows"
}

# Codex: app-server の account/rateLimits/read を呼び、応答の .result を 1 行の JSON で出す。
# モデルを呼ばないので、使用量を消費しない。
# app-server は stdin が閉じると終わるので、応答が来るか 30 秒たつまで、stdin を開けたまま待つ。
read_codex_usage() {
	local out_file
	out_file=$(usage_tmpfile)
	{
		printf '%s\n' \
			'{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"clientInfo":{"name":"squad-usage-check","version":"1.0.0"}}}' \
			'{"jsonrpc":"2.0","method":"initialized"}' \
			'{"jsonrpc":"2.0","id":2,"method":"account/rateLimits/read"}'
		for _ in $(seq 30); do
			grep -q '"id":2' "$out_file" && break
			sleep 1
		done
	} | codex app-server >"$out_file" 2>/dev/null || true

	local res
	res=$(jq -c 'select(.id == 2)' "$out_file" 2>/dev/null || true)
	rm -f "$out_file"
	if [[ -z "$res" ]]; then
		echo "codex app-server から使用量の応答がなかった" >&2
		return 1
	fi
	if ! jq -e '.result' <<<"$res" >/dev/null; then
		echo "codex app-server がエラーを返した: $(jq -r '.error.message // .' <<<"$res")" >&2
		return 1
	fi
	jq -c '.result' <<<"$res"
}
